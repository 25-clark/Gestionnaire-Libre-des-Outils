<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titre !== 'undefined' ? titre + ' · GLO' : 'GLO' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
    <a href="/" class="logo">📁 <span>Gestionnaire</span><span class="accent">Outils</span></a>
    <nav>
        <a href="/">Tableau de bord</a>
        <% if (peut('roles', 'read')) { %>
            <a href="/roles">Rôles</a>
        <% } %>
        <% if (peut('acces', 'read')) { %>
            <a href="/acces">Accès</a>
        <% } %>
    </nav>
    <form action="/recherche" method="GET" class="recherche-topbar">
        <input type="text" name="q" placeholder="Rechercher un outil, un utilisateur..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit" title="Rechercher">🔍</button>
    </form>
    <div class="utilisateur">
        <span><%= currentUser.prenom %> <%= currentUser.nom %></span>
        <% if (currentUser.Role) { %>
            <span class="badge-role"><%= currentUser.Role.abbreviation %></span>
        <% } %>
        <form action="/logout" method="POST" class="form-inline">
            <button type="submit" class="btn-deconnexion">Déconnexion</button>
        </form>
    </div>
</header>
<% } %>
<div class="conteneur">
