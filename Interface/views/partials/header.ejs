<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <title><%= typeof titre !== 'undefined' ? titre + ' · ' + nomApplication : nomApplication %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
    <a href="/" class="logo"><img src="/favicon-32x32.png" alt="favicon"><span><%= nomEntreprise ? nomEntreprise : 'Gestionnaire' %></span></a>
    <nav>
        <a href="/">Tableau de bord</a>
        <% var itemsSecurite = []; %>
        <% if (peut('roles', 'read')) itemsSecurite.push({ href: '/roles', label: 'Rôles' }); %>
        <% if (peut('acces', 'read')) itemsSecurite.push({ href: '/acces', label: 'Accès' }); %>
        <% if (currentUser.Role && currentUser.Role.abbreviation === 'ADMIN') { %>
            <% itemsSecurite.push({ href: '/parametres', label: 'Réglages généraux' }); %>
            <% itemsSecurite.push({ href: '/journal', label: "Journal d'événements" }); %>
            <% itemsSecurite.push({ href: '/statistiques', label: 'Statistiques' }); %>
        <% } %>
        <% itemsSecurite.push({ href: '/changer-mot-de-passe', label: 'Changer mon mot de passe' }); %>
        <% if (itemsSecurite.length) { %>
            <div class="menu-deroulant">
                <button type="button" class="lien-menu-deroulant">Sécurité ▾</button>
                <div class="contenu-menu-deroulant">
                    <% itemsSecurite.forEach(function(item) { %>
                        <a href="<%= item.href %>"><%= item.label %></a>
                    <% }) %>
                </div>
            </div>
        <% } %>
        <% if (peut('outils', 'read')) { %>
            <a href="/diagnostic">Diagnostic réseau</a>
        <% } %>
    </nav>
    <form action="/recherche" method="GET" class="recherche-topbar">
        <input type="text" name="q" placeholder="Rechercher une activité, un outil, un utilisateur..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit" title="Rechercher"><i class="bi bi-search"></i></button>
    </form>
    <div class="utilisateur">
        <span><%= currentUser.prenom %> <%= currentUser.nom %></span>
        <% if (currentUser.Role) { %>
            <span class="badge-role"><%= currentUser.Role.abbreviation %></span>
        <% } %>
        <form action="/logout" method="POST" class="form-inline">
            <button type="submit" class="btn-deconnexion">Déconnexion</button>
        </form>
    </div>
</header>
<% } %>
<div class="conteneur">
