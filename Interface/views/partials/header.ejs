<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'fr' %>">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
 <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
 <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
 <link rel="manifest" href="/site.webmanifest">
 <title><%= typeof titre !== 'undefined' ? titre + ' · ' + nomApplication : nomApplication %></title>
 <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/design-modern.css">
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
 <% 
 var prefsTheme = (typeof prefs !== 'undefined' && prefs.theme) ? prefs.theme : 'clair';
 if (typeof currentUser !== 'undefined' && currentUser && currentUser.preferences && currentUser.preferences.theme) {
 prefsTheme = currentUser.preferences.theme;
 }
 %>
 <script>
 (function () {
 var theme = '<%= prefsTheme %>';
 try {
 var stored = localStorage.getItem('glo_theme');
 if (stored === 'clair' || stored === 'sombre' || stored === 'auto') theme = stored;
 } catch (e) {}
 if (theme === 'auto') {
 theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'sombre' : 'clair';
 }
 if (theme === 'sombre') {
 document.documentElement.classList.add('theme-sombre');
 } else {
 document.documentElement.classList.remove('theme-sombre');
 }
 try { localStorage.setItem('glo_theme', '<%= prefsTheme %>'); } catch (e) {}
 try { localStorage.setItem('glo_langue', '<%= typeof lang !== "undefined" ? lang : "fr" %>'); } catch (e) {}
 })();
 </script>
</head>
<body class="<%= prefsTheme === 'sombre' ? 'theme-sombre' : '' %>">
<script>
 if (document.documentElement.classList.contains('theme-sombre')) {
 document.body.classList.add('theme-sombre');
 } else {
 document.body.classList.remove('theme-sombre');
 }
</script>
<% if (currentUser) { %>
<% var t = typeof t === 'function' ? t : function(k){ return k; }; %>
<% var nav = (typeof nav !== 'undefined' && nav) ? nav : { section: null, item: null }; %>
<% function navActif(section, item) {
     if (item && nav.item === item) return true;
     if (section && nav.section === section && !item) return true;
     return false;
   } %>
<div class="nav-overlay" id="nav-overlay" hidden></div>
<header class="topbar" id="topbar">
 <a href="/" class="logo"><img src="/favicon-32x32.png" alt=""><span><%= nomEntreprise ? nomEntreprise : 'GLO' %></span></a>
 <nav id="nav-principale" class="nav-principale">
 <%/* —— Accueil —— */%>
 <a href="/" class="<%= navActif('dashboard','dashboard') || nav.item==='dashboard' ? 'nav-actif' : '' %>"><%= t('nav.dashboard') %></a>

 <%/* —— Assistance : tickets + diagnostic —— */%>
 <% var itemsAssistance = []; %>
 <% if (peut('tickets', 'read')) itemsAssistance.push({ href: '/tickets', label: t('nav.tickets'), icon: 'bi-ticket-detailed' }); %>
 <% if (peut('diagnostic', 'read')) itemsAssistance.push({ href: '/diagnostic', label: t('nav.diagnostic'), icon: 'bi-hdd-network' }); %>
 <% if (itemsAssistance.length === 1) { %>
 <a href="<%= itemsAssistance[0].href %>" class="<%= (itemsAssistance[0].href==='/tickets' && nav.item==='tickets') || (itemsAssistance[0].href==='/diagnostic' && nav.item==='diagnostic') ? 'nav-actif' : '' %>"><%= itemsAssistance[0].label %></a>
 <% } else if (itemsAssistance.length > 1) { %>
 <div class="menu-deroulant<%= nav.section==='assistance' ? ' menu-actif' : '' %>">
 <button type="button" class="lien-menu-deroulant<%= nav.section==='assistance' ? ' nav-actif' : '' %>"><%= t('nav.assistance') %> <i class="bi bi-chevron-down" style="font-size:0.75em;"></i></button>
 <div class="contenu-menu-deroulant">
 <% itemsAssistance.forEach(function(item) {
   var itemActif = (item.href==='/tickets' && nav.item==='tickets') || (item.href==='/diagnostic' && nav.item==='diagnostic');
 %>
 <a href="<%= item.href %>" class="<%= itemActif ? 'nav-actif' : '' %>"><% if (item.icon) { %><i class="bi <%= item.icon %>"></i> <% } %><%= item.label %></a>
 <% }) %>
 </div>
 </div>
 <% } %>

 <%/* —— Administration : rôles, accès, journal, stats, LDAP, réglages —— */%>
 <% var itemsAdmin = []; %>
 <% if (peut('roles', 'read')) itemsAdmin.push({ href: '/roles', label: t('nav.roles'), icon: 'bi-shield-lock' }); %>
 <% if (peut('acces', 'read')) itemsAdmin.push({ href: '/acces', label: t('nav.access'), icon: 'bi-key' }); %>
 <% if (peut('journal', 'read')) itemsAdmin.push({ href: '/journal', label: t('nav.journal'), icon: 'bi-journal-text' }); %>
 <% if (currentUser.Role && currentUser.Role.abbreviation === 'ADMIN') { %>
 <% itemsAdmin.push({ href: '/statistiques', label: t('nav.stats'), icon: 'bi-graph-up' }); %>
 <% itemsAdmin.push({ href: '/ldap', label: t('nav.ldap'), icon: 'bi-diagram-3' }); %>
 <% itemsAdmin.push({ href: '/parametres', label: t('nav.settings'), icon: 'bi-gear' }); %>
 <% } %>
 <% if (itemsAdmin.length) { %>
 <div class="menu-deroulant<%= nav.section==='administration' ? ' menu-actif' : '' %>">
 <button type="button" class="lien-menu-deroulant<%= nav.section==='administration' ? ' nav-actif' : '' %>"><%= t('nav.administration') %> <i class="bi bi-chevron-down" style="font-size:0.75em;"></i></button>
 <div class="contenu-menu-deroulant">
 <% itemsAdmin.forEach(function(item) {
   var map = { '/roles': 'roles', '/acces': 'acces', '/journal': 'journal', '/statistiques': 'stats', '/ldap': 'ldap', '/parametres': 'settings' };
   var itemActif = nav.item && map[item.href] === nav.item;
 %>
 <a href="<%= item.href %>" class="<%= itemActif ? 'nav-actif' : '' %>"><% if (item.icon) { %><i class="bi <%= item.icon %>"></i> <% } %><%= item.label %></a>
 <% }) %>
 </div>
 </div>
 <% } %>
        <%/* —— Aide (items selon permissions.aide du rôle) —— */%>
        <%
          var aidePerms = null;
          if (currentUser && currentUser.Role && currentUser.Role.permissions) {
            var _p = currentUser.Role.permissions;
            if (typeof _p === 'string') { try { _p = JSON.parse(_p); } catch(e) { _p = {}; } }
            aidePerms = _p.aide || null;
          }
          var itemsAide = [
            { key: 'support', href: '/aide/support', label: 'Support', icon: 'bi-life-preserver' },
            { key: 'documentation', href: '/aide/documentation', label: 'Documentation', icon: 'bi-book' },
            { key: 'mise-a-jour', href: '/aide/mise-a-jour', label: 'Mise à jour', icon: 'bi-arrow-repeat' },
            { key: 'extensions', href: '/aide/extensions', label: 'Extensions', icon: 'bi-puzzle' },
            { key: 'soutien', href: '/aide/soutien', label: 'Soutien', icon: 'bi-heart' },
            { key: 'confidentialite', href: '/aide/confidentialite', label: 'Confidentialité', icon: 'bi-shield-check' }
          ];
          // Rétrocompat : pas de config aide = tout visible. Sinon uniquement les cases cochées.
          var itemsAideVisibles = itemsAide.filter(function(it) {
            if (!aidePerms) return true;
            return !!aidePerms[it.key];
          });
        %>
        <% if (itemsAideVisibles.length) { %>
        <div class="menu-deroulant<%= nav.section==='aide' ? ' menu-actif' : '' %>">
            <button type="button" class="lien-menu-deroulant<%= nav.section==='aide' ? ' nav-actif' : '' %>"><%= typeof t === 'function' ? t('nav.help') : 'Aide' %> <i class="bi bi-chevron-down" style="font-size:0.75em;"></i></button>
            <div class="contenu-menu-deroulant">
                <% itemsAideVisibles.forEach(function(item) { %>
                <a href="<%= item.href %>" class="<%= nav.item===item.key ? 'nav-actif' : '' %>"><i class="bi <%= item.icon %>"></i> <%= item.label %></a>
                <% }) %>
            </div>
        </div>
        <% } %>

 </nav>

 <form action="/recherche" method="GET" class="recherche-topbar">
 <input type="text" name="q" placeholder="<%= t('nav.search') %>" value="<%= typeof q !== 'undefined' ? q : '' %>">
 <button type="submit" title="<%= t('nav.search') %>"><i class="bi bi-search"></i></button>
 </form>

 <div class="utilisateur">
 <% if (peut('notifications', 'read')) { %>
 <a href="/notifications" class="lien-notifications<%= nav.item==='notifications' ? ' nav-actif' : '' %>" title="<%= t('nav.notifications') %>">
 <i class="bi bi-bell"></i>
 <% if (notificationsNonLues > 0) { %>
 <span class="badge-notif"><%= notificationsNonLues > 9 ? '9+' : notificationsNonLues %></span>
 <% } %>
 </a>
 <% } %>
 <div class="menu-deroulant menu-utilisateur<%= nav.section==='profil' ? ' menu-actif' : '' %>">
 <button type="button" class="lien-menu-deroulant lien-utilisateur">
 <span class="nom-utilisateur"><%= currentUser.prenom %> <%= currentUser.nom %></span>
 <% if (currentUser.Role) { %>
 <span class="badge-role"><%= currentUser.Role.abbreviation %></span>
 <% } %>
 <span class="chevron"><i class="bi bi-chevron-down" style="font-size:0.75em;"></i></span>
 </button>
 <div class="contenu-menu-deroulant contenu-menu-utilisateur">
 <% if (peut('profil', 'read')) { %>
 <a href="/profil" class="<%= nav.item==='profil' ? 'nav-actif' : '' %>"><i class="bi bi-person"></i> <%= t('nav.profile') %></a>
 <% } %>
 <form action="/logout" method="POST" class="form-logout-menu">
 <button type="submit"><i class="bi bi-box-arrow-right"></i> <%= t('nav.logout') %></button>
 </form>
 </div>
 </div>
 </div>
 <button type="button" class="btn-nav-mobile" id="btn-nav-mobile" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-principale">
  <i class="bi bi-list" style="font-size:1.35rem;" aria-hidden="true"></i>
 </button>
</header>

<% } %>
<div class="conteneur">
<%- include('fil-ariane') %>
