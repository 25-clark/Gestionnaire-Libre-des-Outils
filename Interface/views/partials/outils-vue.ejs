<% if (!outils.length) { %>
 <div class="carte vide"><%= typeof messageVide !== 'undefined' ? messageVide : "Aucun outil pour l'instant." %></div>
<% } else { %>

 <div style="display:flex; justify-content:flex-end; margin-bottom:12px;">
 <div class="vue-switch">
 <button type="button" class="vue-btn" data-vue="liste"><i class="bi bi-list-ul"></i> Liste</button>
 <button type="button" class="vue-btn" data-vue="cartes"><i class="bi bi-grid"></i> Cartes</button>
 <button type="button" class="vue-btn" data-vue="vignettes">⬚ Vignettes</button>
 </div>
 </div>

 <!-- Vue Liste -->
 <div class="vue-panneau" data-vue="liste">
 <div class="carte">
 <table class="tableau">
 <thead><tr><th></th><th>Nom</th><th>Lien</th><th>Propriétaire</th><th>Statut</th><th>Réseau</th><th></th></tr></thead>
 <tbody>
 <% outils.forEach(function(o) { %>
 <tr>
 <td><% if (o.image) { %><img src="<%= o.image %>" class="miniature"><% } %></td>
 <td><%= o.nom %><% if (o.en_derangement) { %> <span class="badge-derangement" title="<%= o.derangement_message || o.note_maintenance || 'Dérangement en cours' %>"><i class="bi bi-exclamation-triangle"></i> Maintenance</span><% } %></td>
 <td>
 <% if (o.lien) { %>
 <a href="<%= o.lien %>" target="_blank" rel="noopener" class="lien-ouvrir-outil"
 data-creds='<%= JSON.stringify(o.credentials || []).replace(/'/g, "&#39;") %>'>Ouvrir ↗</a>
 <% } else { %>—<% } %>
 <% var hasCreds = o.credentials && (Array.isArray(o.credentials) ? o.credentials.length : true); %>
 
                            <% var _ep = (typeof favorisOutilsIds !== 'undefined' && favorisOutilsIds.map(Number).indexOf(Number(o.id)) >= 0); %>
<button type="button" class="btn btn-gris btn-petit btn-favori<%= _ep ? ' est-epingle' : '' %>" data-favori-type="outil" data-favori-id="<%= o.id %>" title="<%= _ep ? 'Retirer des épinglés' : 'Épingler' %>"><i class="bi <%= _ep ? 'bi-pin-angle-fill' : 'bi-pin-angle' %>"></i></button>
                            <% if (peut('outils', 'update')) { %>
                                <a href="/outils/<%= o.id %>/maintenance?retour=<%= encodeURIComponent(typeof retour !== 'undefined' ? retour : '/') %>" class="btn btn-gris btn-petit" title="Maintenance / dérangement"><i class="bi bi-tools"></i></a>
                            <% } %>
                            <% if (credentialsActifs && peut('credentials', 'read')) { %>
 <a href="/outils/<%= o.id %>/credentials?retour=<%= encodeURIComponent(retour) %>"
 class="btn btn-gris btn-petit" title="Credentials" style="margin-left:4px;"><i class="bi bi-key"></i> </a>
 <% } %>
 </td>
 <td><%= o.Utilisateur ? o.Utilisateur.prenom + ' ' + o.Utilisateur.nom : '—' %></td>
 <td>
 <% if (o.active) { %>
 <span class="pastille pastille-active">Actif</span>
 <% } else { %>
 <span class="pastille pastille-inactive">Désactivé</span>
 <% } %>
 </td>
 <td style="white-space:nowrap;">
 <%- include('statut-reseau', { o: o, retour: retour }) %>
 </td>
 <td style="text-align:right; white-space:nowrap;">
 <% if (peut('tickets', 'create')) { %>
 <a href="/tickets/nouveau?id_outil=<%= o.id %>" class="btn btn-gris btn-petit" title="Signaler un problème sur cet outil"><i class="bi bi-ticket-detailed"></i> Signaler</a>
 
                            <% if (peut('outils', 'update')) { %>
                                <a href="/outils/<%= o.id %>/maintenance?retour=<%= encodeURIComponent(typeof retour !== 'undefined' ? retour : '/') %>" class="btn btn-gris btn-petit" title="Maintenance / dérangement"><i class="bi bi-tools"></i></a>
                            <% } %>
                            <% if (credentialsActifs && peut('credentials', 'read')) { %>
 <a href="/outils/<%= o.id %>/credentials?retour=<%= encodeURIComponent(retour) %>" class="btn btn-gris btn-petit" title="Credentials de l'outil"><i class="bi bi-key"></i> Credentials</a>
 <% } %>
 <% if (peut('partage', 'create') || peut('partage', 'delete')) { %>
 <a href="/outils/<%= o.id %>/partager?retour=<%= encodeURIComponent(retour) %>" class="btn btn-gris btn-petit" title="Partager cet outil"><i class="bi bi-link-45deg"></i> Partager</a>
 <% } %>
 <% } %>
 <% if (o.adresse) { %>
 <a href="/diagnostic?cible=<%= encodeURIComponent(o.adresse) %>" class="btn btn-gris btn-petit" title="Tester la connectivité de <%= o.adresse %>"><i class="bi bi-heart-pulse"></i> Tester</a>
 <% } %>
 <% if (peut('outils', 'update')) { %>
 <form action="/outils/<%= o.id %>/toggle-active" method="POST" class="form-inline">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" class="btn btn-gris btn-petit"><%= o.active ? 'Désactiver' : 'Activer' %></button>
 </form>
 <% } %>
 <% if (peut('outils', 'delete')) { %>
 <form action="/outils/<%= o.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Supprimer cet outil ?');">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" class="btn btn-danger btn-petit">Supprimer</button>
 </form>
 <% } %>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 </div>

 <!-- Vue Cartes -->
 <div class="vue-panneau" data-vue="cartes">
 <div class="grille-cartes">
 <% outils.forEach(function(o) { %>
 <div class="carte-outil">
 <div class="image-outil">
 <% if (o.image) { %>
 <img src="<%= o.image %>" alt="<%= o.nom %>">
 <% } else { %>
 <span class="icone-defaut"><i class="bi bi-tools"></i> </span>
 <% } %>
 </div>
 <div class="corps-carte">
 <span class="nom-outil"><%= o.nom %></span>
 <span class="proprietaire-outil"><%= o.Utilisateur ? o.Utilisateur.prenom + ' ' + o.Utilisateur.nom : '—' %></span>
 <% if (o.active) { %>
 <span class="pastille pastille-active" style="width:fit-content;">Actif</span>
 <% } else { %>
 <span class="pastille pastille-inactive" style="width:fit-content;">Désactivé</span>
 <% } %>
 <% if (o.adresse) { %>
 <div style="margin-top:2px;"><%- include('statut-reseau', { o: o, retour: retour }) %></div>
 <% } %>
 </div>
 <div class="pied-carte">
 <% if (o.lien) { %>
 <a href="<%= o.lien %>" target="_blank" rel="noopener" style="font-size:12px;" class="lien-ouvrir-outil" data-creds='<%= JSON.stringify(o.credentials || []).replace(/'/g, "&#39;") %>'>Ouvrir ↗</a>
 <% } else { %>
 <span></span>
 <% } %>
 <div style="display:flex; gap:4px;">
 <% if (peut('tickets', 'create')) { %>
 <a href="/tickets/nouveau?id_outil=<%= o.id %>" class="btn btn-gris btn-petit" title="Signaler un problème"><i class="bi bi-ticket-detailed"></i> </a>
 
                            <% var _ep = (typeof favorisOutilsIds !== 'undefined' && favorisOutilsIds.map(Number).indexOf(Number(o.id)) >= 0); %>
<button type="button" class="btn btn-gris btn-petit btn-favori<%= _ep ? ' est-epingle' : '' %>" data-favori-type="outil" data-favori-id="<%= o.id %>" title="<%= _ep ? 'Retirer des épinglés' : 'Épingler' %>"><i class="bi <%= _ep ? 'bi-pin-angle-fill' : 'bi-pin-angle' %>"></i></button>
                            <% if (peut('outils', 'update')) { %>
                                <a href="/outils/<%= o.id %>/maintenance?retour=<%= encodeURIComponent(typeof retour !== 'undefined' ? retour : '/') %>" class="btn btn-gris btn-petit" title="Maintenance / dérangement"><i class="bi bi-tools"></i></a>
                            <% } %>
                            <% if (credentialsActifs && peut('credentials', 'read')) { %>
 <a href="/outils/<%= o.id %>/credentials?retour=<%= encodeURIComponent(retour) %>" class="btn btn-gris btn-petit" title="Credentials"><i class="bi bi-key"></i> </a>
 <% } %>
 <% if (peut('partage', 'create') || peut('partage', 'delete')) { %>
 <a href="/outils/<%= o.id %>/partager?retour=<%= encodeURIComponent(retour) %>" class="btn btn-gris btn-petit" title="Partager cet outil"><i class="bi bi-link-45deg"></i> </a>
 <% } %>
 <% } %>
 <% if (o.adresse) { %>
 <a href="/diagnostic?cible=<%= encodeURIComponent(o.adresse) %>" class="btn btn-gris btn-petit" title="Tester la connectivité"><i class="bi bi-heart-pulse"></i> </a>
 <% } %>
 <% if (peut('outils', 'update')) { %>
 
                            <form action="/outils/<%= o.id %>/toggle-active" method="POST" class="form-inline">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" class="btn btn-gris btn-petit"><%= o.active ? 'Désactiver' : 'Activer' %></button>
 </form>
 <% } %>
 <% if (peut('outils', 'delete')) { %>
 <form action="/outils/<%= o.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Supprimer cet outil ?');">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" class="btn btn-danger btn-petit">Suppr.</button>
 </form>
 <% } %>
 </div>
 </div>
 </div>
 <% }) %>
 </div>
 </div>

 <!-- Vue Vignettes -->
 <div class="vue-panneau" data-vue="vignettes">
 <div class="grille-vignettes">
 <% outils.forEach(function(o) { %>
 <div class="vignette-outil" title="<%= o.nom %> — <%= o.Utilisateur ? o.Utilisateur.prenom + ' ' + o.Utilisateur.nom : '—' %>">
 <span class="point-statut <%= o.active ? 'actif' : 'inactif' %>"></span>
 <div class="image-vignette">
 <% if (o.image) { %>
 <img src="<%= o.image %>" alt="<%= o.nom %>">
 <% } else { %>
 <span class="icone-defaut"><i class="bi bi-tools"></i> </span>
 <% } %>
 </div>
 <span class="nom-vignette"><%= o.nom %></span>
 <% if (o.adresse) { %>
 <div style="margin-top:3px;">
 <% if (o.dernier_statut === 'en_ligne') { %>
 <span class="pastille-reseau en-ligne" style="font-size:10px; padding:1px 6px;"><i class="bi bi-circle-fill text-statut-ok"></i> </span>
 <% } else if (o.dernier_statut === 'hors_ligne') { %>
 <span class="pastille-reseau hors-ligne" style="font-size:10px; padding:1px 6px;"><i class="bi bi-circle-fill text-statut-ko"></i> </span>
 <% } else { %>
 <span class="pastille-reseau inconnu" style="font-size:10px; padding:1px 6px;"><i class="bi bi-circle text-statut-na"></i> </span>
 <% } %>
 </div>
 <% } %>
 <% if (o.adresse || peut('outils', 'update') || peut('outils', 'delete') || peut('tickets', 'create')) { %>
 <div class="actions-vignette">


 <% if (peut('tickets', 'create')) { %>
 <a href="/tickets/nouveau?id_outil=<%= o.id %>" title="Signaler un problème"><i class="bi bi-ticket-detailed"></i> </a>
 
                            <% var _ep = (typeof favorisOutilsIds !== 'undefined' && favorisOutilsIds.map(Number).indexOf(Number(o.id)) >= 0); %>
<button type="button" class="btn btn-gris btn-petit btn-favori<%= _ep ? ' est-epingle' : '' %>" data-favori-type="outil" data-favori-id="<%= o.id %>" title="<%= _ep ? 'Retirer des épinglés' : 'Épingler' %>"><i class="bi <%= _ep ? 'bi-pin-angle-fill' : 'bi-pin-angle' %>"></i></button>
                            <% if (peut('outils', 'update')) { %>
                                <a href="/outils/<%= o.id %>/maintenance?retour=<%= encodeURIComponent(typeof retour !== 'undefined' ? retour : '/') %>" class="btn btn-gris btn-petit" title="Maintenance / dérangement"><i class="bi bi-tools"></i></a>
                            <% } %>
                            <% if (credentialsActifs && peut('credentials', 'read')) { %>
 <a href="/outils/<%= o.id %>/credentials?retour=<%= encodeURIComponent(retour) %>" title="Credentials"><i class="bi bi-key"></i> </a>
 <% } %>
 <% if (peut('partage', 'create') || peut('partage', 'delete')) { %>
 <a href="/outils/<%= o.id %>/partager?retour=<%= encodeURIComponent(retour) %>" title="Partager cet outil"><i class="bi bi-link-45deg"></i> </a>
 <% } %>
 <% } %>
 <% if (o.adresse) { %>
 <a href="/diagnostic?cible=<%= encodeURIComponent(o.adresse) %>" title="Tester la connectivité"><i class="bi bi-heart-pulse"></i> </a>
 <% } %>
 <% if (peut('outils', 'update')) { %>
 <form action="/outils/<%= o.id %>/toggle-active" method="POST" class="form-inline">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" title="<%= o.active ? 'Désactiver' : 'Activer' %>"><%= o.active ? '⏸' : '▶' %></button>
 </form>
 <% } %>
 <% if (peut('outils', 'delete')) { %>
 <form action="/outils/<%= o.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Supprimer cet outil ?');">
 <input type="hidden" name="retour" value="<%= retour %>">
 <button type="submit" title="Supprimer"><i class="bi bi-trash"></i></button>
 </form>
 <% } %>
 </div>
 <% } %>
 </div>
 <% }) %>
 </div>
 </div>

 <script>
 (function () {
 var boutons = document.querySelectorAll('.vue-btn');
 var panneaux = document.querySelectorAll('.vue-panneau');
 var cle = 'glo-vue-outils';

 function activer(vue) {
 panneaux.forEach(function (p) { p.style.display = (p.dataset.vue === vue) ? '' : 'none'; });
 boutons.forEach(function (b) { b.classList.toggle('actif', b.dataset.vue === vue); });
 try { localStorage.setItem(cle, vue); } catch (e) {}
 }

 boutons.forEach(function (b) {
 b.addEventListener('click', function () { activer(b.dataset.vue); });
 });

 var sauvegarde = null;
 try { sauvegarde = localStorage.getItem(cle); } catch (e) {}
 activer((sauvegarde && ['liste', 'cartes', 'vignettes'].includes(sauvegarde)) ? sauvegarde : 'liste');
 })();
 </script>
<% } %>

<script>
document.addEventListener('click', function (e) {
 var a = e.target.closest && e.target.closest('a.lien-ouvrir-outil');
 if (!a) return;
 var raw = a.getAttribute('data-creds');
 if (!raw) return;
 try {
 var creds = JSON.parse(raw);
 if (!Array.isArray(creds) || !creds.length) return;
 var parts = creds.filter(function (c) { return c && c.valeur; })
 .map(function (c) { return (c.label || 'Champ') + ' : ' + c.valeur; });
 if (parts.length && typeof gloCopier === 'function') {
 // Copie sans bloquer l'ouverture du lien
 setTimeout(function () { gloCopier(parts.join('\n')); }, 50);
 }
 } catch (_) {}
});
</script>
