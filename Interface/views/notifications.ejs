<%- include('partials/header') %>

<div class="entete-page">
  <h1><i class="bi bi-bell"></i> Notifications</h1>
  <% if (notifications && notifications.length) { %>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <form action="/assistance/notifications/toutes-lues" method="POST" style="margin:0;">
      <button type="submit" class="btn btn-gris btn-petit">Tout marquer comme lu</button>
    </form>
    <form action="/assistance/notifications/vider" method="POST" style="margin:0;"
      onsubmit="return confirm('Supprimer définitivement toutes les notifications ?');">
      <button type="submit" class="btn btn-gris btn-petit"><i class="bi bi-trash"></i> Vider</button>
    </form>
  </div>
  <% } %>
</div>

<% if (!notifications || !notifications.length) { %>
  <div class="carte vide">Vous n'avez aucune notification pour le moment.</div>
<% } else { %>
  <div class="liste-notifications" style="max-width:720px;display:flex;flex-direction:column;gap:12px;">
    <% notifications.forEach(function(n) {
      var isAlerte = n.type === 'alerte' || (n.message && /SLA/i.test(n.message));
      var isEsc = n.message && /escalad/i.test(n.message);
      var cls = 'notif-carte';
      if (!n.lu) cls += ' notif-non-lue';
      if (isAlerte) cls += ' notif-alerte';
      if (isEsc) cls += ' notif-escalade';
    %>
    <a href="/assistance/notifications/<%= n.id %>/ouvrir" class="<%= cls %>">
      <span class="notif-icone">
        <% if (isAlerte) { %><i class="bi bi-exclamation-triangle-fill"></i>
        <% } else if (n.type === 'succes') { %><i class="bi bi-check-circle-fill"></i>
        <% } else if (isEsc) { %><i class="bi bi-arrow-up-circle-fill"></i>
        <% } else { %><i class="bi bi-info-circle-fill"></i><% } %>
      </span>
      <span class="notif-corps">
        <span class="notif-texte<%= n.lu ? '' : ' notif-texte-bold' %>"><%= n.message %></span>
        <span class="notif-meta">
          <%= new Date(n.createdAt).toLocaleString('fr-FR') %>
          <% if (!n.lu) { %> · <strong>non lue</strong><% } %>
          · <span class="notif-ouvrir-label">Ouvrir</span>
        </span>
      </span>
      <span class="notif-chevron"><i class="bi bi-chevron-right"></i></span>
    </a>
    <% }) %>
  </div>

  <% if (totalPages > 1) { %>
  <div style="display:flex;gap:8px;margin-top:16px;align-items:center;">
    <% if (page > 1) { %>
    <a href="/assistance/notifications?page=<%= page - 1 %>" class="btn btn-gris btn-petit"><i class="bi bi-arrow-left"></i> Précédent</a>
    <% } %>
    <span style="color:var(--gris);font-size:13px;">Page <%= page %> / <%= totalPages %></span>
    <% if (page < totalPages) { %>
    <a href="/assistance/notifications?page=<%= page + 1 %>" class="btn btn-gris btn-petit">Suivant <i class="bi bi-arrow-right"></i></a>
    <% } %>
  </div>
  <% } %>
<% } %>

<style>
.liste-notifications { margin-top: 4px; }
.notif-carte {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 18px;
  border-radius: 12px;
  border: 1px solid var(--gris-bordure, #e2e8f0);
  background: #fff;
  text-decoration: none !important;
  color: inherit;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
}
.notif-carte:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
}
.notif-non-lue {
  border-left: 4px solid var(--bleu, #2563eb);
  background: #f8fbff;
}
.notif-alerte {
  border-left: 4px solid #f59e0b;
  background: #fffbeb;
  padding: 16px 18px;
}
.notif-escalade {
  border-left: 4px solid #ef4444;
  background: #fef2f2;
  padding: 16px 18px;
}
.notif-icone {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  color: var(--bleu, #2563eb);
  font-size: 1.1rem;
}
.notif-alerte .notif-icone { background: #fef3c7; color: #d97706; }
.notif-escalade .notif-icone { background: #fee2e2; color: #dc2626; }
.notif-corps { flex: 1; min-width: 0; }
.notif-texte { display: block; font-size: 14px; line-height: 1.45; }
.notif-texte-bold { font-weight: 600; }
.notif-meta {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  color: var(--gris, #64748b);
}
.notif-ouvrir-label { color: var(--bleu, #2563eb); font-weight: 500; }
.notif-chevron {
  flex-shrink: 0;
  color: #94a3b8;
  align-self: center;
  font-size: 1rem;
}
body.theme-sombre .notif-carte {
  background: #1e293b;
  border-color: #334155;
  color: #e2e8f0;
}
body.theme-sombre .notif-carte:hover { background: #273549; }
body.theme-sombre .notif-non-lue { background: #1e3a5f; }
body.theme-sombre .notif-alerte { background: #422006; }
body.theme-sombre .notif-escalade { background: #450a0a; }
body.theme-sombre .notif-icone { background: #334155; }
</style>

<%- include('partials/footer') %>
