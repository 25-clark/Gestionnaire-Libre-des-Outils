<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2FA · <%= typeof nomApplication !== 'undefined' ? nomApplication : 'GLO' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/design-modern.css">
</head>
<body class="page-login">
<div class="carte-login">
    <h1><i class="bi bi-shield-lock"></i> Vérification 2FA</h1>
    <p class="sous-titre">Saisissez le code à 6 chiffres de votre application d'authentification.</p>
    <% if (erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>
    <form action="/login/2fa" method="POST">
        <label for="code">Code</label>
        <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code" placeholder="000000">
        <button type="submit" class="btn btn-primaire">Valider</button>
        <p style="margin-top:14px;"><a href="/login" style="color:var(--gris);">← Retour à la connexion</a></p>
    </form>
</div>
</body>
</html>
