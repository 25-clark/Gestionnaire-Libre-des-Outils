<%- include('partials/header') %>
<% var t = typeof t === 'function' ? t : function(k){ return k; }; %>
<% 
 var prefs = (user.preferences && typeof user.preferences === 'object')
 ? user.preferences
 : (typeof prefs !== 'undefined' ? prefs : { theme: 'clair', langue: 'fr' });
 if (typeof user.preferences === 'string') {
 try { prefs = JSON.parse(user.preferences); } catch (_) {}
 }
 var contacts = [];
 if (Array.isArray(user.autres_contacts)) {
 contacts = user.autres_contacts;
 } else if (typeof user.autres_contacts === 'string' && user.autres_contacts.trim()) {
 try {
 var parsed = JSON.parse(user.autres_contacts);
 contacts = Array.isArray(parsed) ? parsed : [user.autres_contacts];
 } catch (_) {
 contacts = user.autres_contacts.split(/[,;]/).map(function(s) { return s.trim(); }).filter(Boolean);
 }
 }
 if (!contacts.length) contacts = [''];
%>
<div class="entete-page"><h1><%= t('profile.title') %></h1></div>

<% if (erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>
<% if (succes) { %>
<div class="message-succes"><%= succes === 'prefs' ? t('profile.prefs.saved') : (succes === 'infos' ? t('profile.info.saved') : succes) %></div>
<script>
 // Persister thème / langue juste après sauvegarde des préférences
 try {
 var themeSel = document.getElementById('theme');
 var langSel = document.getElementById('langue');
 if (themeSel) localStorage.setItem('glo_theme', themeSel.value);
 if (langSel) localStorage.setItem('glo_langue', langSel.value);
 } catch (e) {}
</script>
<% } %>

<div class="profil-grille">
 <div class="carte">
 <h2><i class="bi bi-person-badge"></i> <%= t('profile.personal') %></h2>
 <form action="/profil" method="POST" id="form-infos">
 <input type="hidden" name="section" value="infos">

 <label for="matricule"><%= t('common.matricule') %></label>
 <% var peutIdentite = peut('profil', 'update_identite') || peut('utilisateurs', 'update'); %>
 <input type="text" id="matricule" name="matricule" value="<%= user.matricule || '' %>" <%= peutIdentite ? '' : 'disabled readonly' %> class="<%= peutIdentite ? '' : 'champ-lecture' %>">

 <label for="role_affiche">Rôle principal</label>
 <select id="role_affiche" disabled class="champ-lecture">
 <option selected><%= user.Role ? (user.Role.nom + (user.Role.abbreviation ? ' (' + user.Role.abbreviation + ')' : '')) : '—' %></option>
 </select>
 <% var rolesAdd = (user.Roles || []).filter(function(r) {
      return !user.Role || r.id !== user.Role.id;
    }); %>
 <% if (rolesAdd.length) { %>
 <label style="margin-top:10px;">Rôles additionnels</label>
 <div class="roles-chips" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
  <% rolesAdd.forEach(function(r) { %>
  <span class="role-chip role-chip-readonly">
    <span class="role-chip-label"><%= r.nom %><% if (r.abbreviation) { %> <em>(<%= r.abbreviation %>)</em><% } %></span>
  </span>
  <% }) %>
 </div>
 <% } %>

 <label for="nom_affiche">Nom</label>
 <input type="text" id="nom" name="nom" value="<%= user.nom || '' %>" <%= peutIdentite ? '' : 'disabled readonly' %> class="<%= peutIdentite ? '' : 'champ-lecture' %>">

 <label for="prenom_affiche">Prénom</label>
 <input type="text" id="prenom" name="prenom" value="<%= user.prenom || '' %>" <%= peutIdentite ? '' : 'disabled readonly' %> class="<%= peutIdentite ? '' : 'champ-lecture' %>">

 <label for="email"><%= t('profile.email') %></label>
 <input type="email" id="email" name="email" value="<%= user.email || '' %>" placeholder="prenom.nom@exemple.com">

 <label for="telephone"><%= t('profile.phone') %></label>
 <input type="text" id="telephone" name="telephone" value="<%= user.telephone || '' %>" placeholder="+33 6 12 34 56 78">

 <label><%= t('profile.contacts') %></label>
 <div class="contacts-liste" id="contacts-liste">
 <% contacts.forEach(function(c) { %>
 <div class="contact-ligne">
 <input type="text" name="autres_contacts[]" value="<%= c %>" placeholder="Teams, Slack, LinkedIn…">
 <button type="button" class="btn-retirer" title="×" onclick="this.parentElement.remove()">&times;</button>
 </div>
 <% }) %>
 </div>
 <button type="button" class="btn-ajouter-contact" onclick="ajouterContact()">+ Ajouter</button>

 <label for="fonction" style="margin-top:14px;"><%= t('profile.function') %></label>
 <input type="text" id="fonction" name="fonction" value="<%= user.fonction || '' %>">

 <label for="adresse"><%= t('profile.address') %></label>
 <textarea id="adresse" name="adresse" rows="2"><%= user.adresse || '' %></textarea>

 <div class="actions-form">
 <button type="submit" class="btn btn-primaire"><%= t('profile.save.info') %></button>
 </div>

 <p style="margin-top:16px;">
 <a href="/changer-mot-de-passe" class="lien-mdp"><i class="bi bi-key"></i> <%= t('profile.change.password') %></a>
 </p>
 </form>
 </div>

 <div class="carte">
 <h2><i class="bi bi-sliders"></i> <%= t('profile.prefs') %></h2>
 <form action="/profil" method="POST" id="form-prefs">
 <input type="hidden" name="section" value="preferences">

 <label for="theme"><%= t('profile.theme') %></label>
 <select id="theme" name="theme">
 <option value="clair" <%= prefs.theme === 'clair' ? 'selected' : '' %>><%= t('profile.theme.light') %></option>
 <option value="sombre" <%= prefs.theme === 'sombre' ? 'selected' : '' %>><%= t('profile.theme.dark') %></option>
 <option value="auto" <%= prefs.theme === 'auto' ? 'selected' : '' %>><%= t('profile.theme.auto') %></option>
 </select>
 <p style="color:var(--gris); font-size:12px; margin-top:-6px;"><%= t('profile.theme.hint') %></p>

 <label for="langue"><%= t('profile.lang') %></label>
 <select id="langue" name="langue">
 <option value="fr" <%= prefs.langue === 'fr' ? 'selected' : '' %>>Français</option>
 <option value="en" <%= prefs.langue === 'en' ? 'selected' : '' %>>English</option>
 </select>

 <div class="actions-form">
 <button type="submit" class="btn btn-primaire"><%= t('profile.save.prefs') %></button>
 </div>
 </form>
 </div>
</div>

<script>
function ajouterContact() {
 var liste = document.getElementById('contacts-liste');
 var div = document.createElement('div');
 div.className = 'contact-ligne';
 div.innerHTML = '<input type="text" name="autres_contacts[]" value="" placeholder="Teams, Slack…">' +
 '<button type="button" class="btn-retirer" onclick="this.parentElement.remove()">&times;</button>';
 liste.appendChild(div);
}
// Aperçu immédiat du thème à la sélection
document.getElementById('theme').addEventListener('change', function () {
 var theme = this.value;
 if (theme === 'auto') {
 theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'sombre' : 'clair';
 }
 document.documentElement.classList.toggle('theme-sombre', theme === 'sombre');
 document.body.classList.toggle('theme-sombre', theme === 'sombre');
});
</script>

    <div class="carte" style="margin-top:18px;">
        <h2><i class="bi bi-shield-check"></i> Facteurs d’authentification</h2>
        <p style="color:var(--gris);font-size:13px;max-width:560px;">
            En plus de votre mot de passe, choisissez les facteurs que <strong>vous</strong> souhaitez utiliser :
            application 2FA (TOTP), code à usage unique, ou les deux. Rien n’est imposé globalement.
        </p>
        <form action="/profil" method="POST">
            <input type="hidden" name="section" value="auth_facteurs">
            <label style="display:flex;align-items:center;gap:8px;margin:12px 0;cursor:pointer;">
                <input type="checkbox" disabled <%= user.totp_actif ? 'checked' : '' %>>
                <span>2FA (application d’authentification) — <%= user.totp_actif ? 'activée (voir section ci-dessous)' : 'à configurer dans la section 2FA ci-dessous' %></span>
            </label>
            <label style="display:flex;align-items:center;gap:8px;margin:12px 0;cursor:pointer;">
                <input type="checkbox" name="auth_code_actif" value="1" <%= (user.preferences && user.preferences.auth_code_actif) ? 'checked' : '' %>>
                <span>Code de connexion par e-mail</span>
            </label>
            <p style="font-size:12px;color:var(--gris);max-width:560px;">
                <strong>Les facteurs se cumulent, ils ne se remplacent pas :</strong>
            </p>
            <ul style="font-size:12px;color:var(--gris);max-width:560px;margin:6px 0 12px 18px;">
                <li><strong>2FA seule</strong> (app type Google Authenticator) → mot de passe puis code de l’app</li>
                <li><strong>E-mail seul</strong> → mot de passe puis code reçu sur Gmail</li>
                <li><strong>2FA + e-mail</strong> → mot de passe, <em>puis</em> code de l’app, <em>puis</em> code reçu par e-mail</li>
            </ul>
            <p style="font-size:12px;color:var(--gris);max-width:560px;">
                Une adresse e-mail valide est obligatoire pour activer le code par e-mail.
            </p>
            <button type="submit" class="btn btn-primaire btn-petit">Enregistrer</button>
        </form>
    </div>


    <div class="carte" style="grid-column: 1 / -1;">
        <h2><i class="bi bi-shield-lock"></i> Authentification à deux facteurs (2FA)</h2>
        <p style="color:var(--gris);font-size:13px; max-width:640px;">
            La 2FA ajoute un <strong>code à 6 chiffres</strong> (qui change toutes les 30 secondes)
            en plus de votre mot de passe. Ce code est généré par une application sur votre téléphone.
        </p>
        <div id="bloc-2fa">
            <p>Statut : <strong id="2fa-statut"><%= user.totp_actif ? 'Activée ✓' : 'Désactivée' %></strong></p>
            <% if (!user.totp_actif) { %>
            <button type="button" class="btn btn-primaire" id="btn-2fa-setup">Commencer la configuration</button>
            <div id="2fa-setup-panel" hidden style="margin-top:16px; max-width:560px;">
                <ol style="padding-left:20px; line-height:1.55; font-size:14px;">
                    <li style="margin-bottom:10px;">
                        <strong>Installez une application</strong> sur votre téléphone, par exemple&nbsp;:
                        <em>Google Authenticator</em>, <em>Microsoft Authenticator</em> ou <em>Authy</em>
                        (disponible gratuitement sur l’App Store / Play Store).
                    </li>
                    <li style="margin-bottom:10px;">
                        <strong>Dans l’application, ajoutez un compte</strong> (souvent « + » ou « Ajouter »)
                        puis choisissez <strong>« Scanner un QR code »</strong>.
                    </li>
                    <li style="margin-bottom:10px;">
                        <strong>Scannez le QR code ci-dessous</strong> avec l’appareil photo de l’app.
                        <div style="margin:12px 0; text-align:center;">
                            <img id="2fa-qr" alt="QR code 2FA" width="180" height="180"
                                 style="border:1px solid var(--gris-bordure); border-radius:12px; background:#fff; display:none;">
                        </div>
                        <details style="font-size:13px; color:var(--gris);">
                            <summary style="cursor:pointer;">Impossible de scanner ? Saisie manuelle</summary>
                            <p style="margin:8px 0 4px;">Copiez cette clé dans l’app (option « Saisir une clé ») :</p>
                            <code id="2fa-secret" style="user-select:all; display:inline-block; padding:6px 10px; background:var(--gris-clair); border-radius:8px;"></code>
                            <p style="margin:8px 0 0; font-size:12px;">Le lien technique (URI) sert uniquement aux apps avancées — vous pouvez l’ignorer.</p>
                            <span id="2fa-uri" style="display:none;"></span>
                        </details>
                    </li>
                    <li>
                        <strong>L’app affiche un code à 6 chiffres</strong> qui change toutes les 30 secondes.
                        Saisissez-le ici pour confirmer que tout fonctionne, puis cliquez sur Activer.
                        <div style="margin-top:10px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                            <input type="text" id="2fa-code-activer" maxlength="6" inputmode="numeric" placeholder="123456" style="max-width:140px; letter-spacing:0.2em; font-size:18px; text-align:center;">
                            <button type="button" class="btn btn-primaire" id="btn-2fa-activer">Activer la 2FA</button>
                        </div>
                    </li>
                </ol>
            </div>
            <% } else { %>
            <p style="font-size:13px; color:var(--gris);">À chaque connexion, GLO vous demandera le code affiché dans votre application.</p>
            <label for="2fa-code-off">Pour désactiver : saisissez le code actuel de l’app</label>
            <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                <input type="text" id="2fa-code-off" maxlength="6" inputmode="numeric" placeholder="123456" style="max-width:140px;">
                <button type="button" class="btn btn-gris" id="btn-2fa-off">Désactiver la 2FA</button>
            </div>
            <% } %>
            <p id="2fa-msg" style="font-size:13px;margin-top:10px;"></p>
        </div>
    </div>
<script>
(function(){
  var msg = document.getElementById('2fa-msg');
  function say(t, ok){ if(msg){ msg.textContent=t; msg.style.color=ok?'#047857':'#b91c1c'; } }
  var btnSetup = document.getElementById('btn-2fa-setup');
  if (btnSetup) btnSetup.addEventListener('click', function(){
    fetch('/profil/2fa/setup', { method:'POST', credentials:'same-origin' })
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(x){
        if(!x.ok) return say(x.d.message||'Erreur');
        document.getElementById('2fa-setup-panel').hidden=false;
        document.getElementById('2fa-secret').textContent=x.d.secret;
        var uri = x.d.otpauth_url || '';
        document.getElementById('2fa-uri').textContent=uri;
        var qr = document.getElementById('2fa-qr');
        if (qr && uri) {
          qr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(uri);
          qr.style.display = 'inline-block';
        }
        say('QR code prêt — scannez-le avec votre application Authenticator.', true);
      }).catch(function(){ say('Erreur réseau'); });
  });
  var btnAct = document.getElementById('btn-2fa-activer');
  if (btnAct) btnAct.addEventListener('click', function(){
    var code = (document.getElementById('2fa-code-activer')||{}).value;
    fetch('/profil/2fa/activer', { method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json'}, body: JSON.stringify({code:code}) })
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(x){ if(x.ok){ say(x.d.message,true); location.reload(); } else say(x.d.message||'Code incorrect'); });
  });
  var btnOff = document.getElementById('btn-2fa-off');
  if (btnOff) btnOff.addEventListener('click', function(){
    var code = (document.getElementById('2fa-code-off')||{}).value;
    fetch('/profil/2fa/desactiver', { method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json'}, body: JSON.stringify({code:code}) })
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(x){ if(x.ok){ say(x.d.message,true); location.reload(); } else say(x.d.message||'Code incorrect'); });
  });
})();
</script>

<%- include('partials/footer') %>
