<%- include('../partials/header') %>

<div class="fil-ariane"><a href="/sous-activites/<%= sousActivite.id %>"><%= sousActivite.nom %></a> <span class="sep">›</span> Copier</div>
<div class="entete-page"><h1>📑 Copier — <%= sousActivite.nom %></h1></div>
<p style="color:var(--gris); font-size:14px; margin-top:-10px;">
    Crée une <strong>copie indépendante</strong> de « <%= sousActivite.nom %> » et de toutes ses sous-activités
    descendantes, à l'endroit choisi ci-dessous. Ce n'est pas un lien partagé (contrairement au partage d'outil) :
    une fois copiée, elle évolue séparément de l'originale.
</p>

<% if (succes) { %>
    <div class="message-succes">Copie effectuée avec succès (avec tous ses descendants).</div>
<% } %>
<% if (erreur) { %>
    <div class="message-erreur" style="max-width:600px;"><%= erreur %></div>
<% } %>

<% if (peut('partage', 'create')) { %>
<div class="carte" style="max-width:600px;">
    <form action="/sous-activites/<%= sousActivite.id %>/copier" method="POST">
        <label for="id_activite_destination">Activité de destination</label>
        <select id="id_activite_destination" name="id_activite_destination" required onchange="rechargerSousActivites()">
            <option value="">— Choisir —</option>
            <% activites.forEach(function(a) { %>
                <option value="<%= a.id %>" <%= String(id_activite_destination) === String(a.id) ? 'selected' : '' %>><%= a.nom %></option>
            <% }) %>
        </select>

        <% if (id_activite_destination && sousActivitesDisponibles.length) { %>
            <label for="id_parent_destination">Sous-activité parente (optionnel)</label>
            <select id="id_parent_destination" name="id_parent_destination">
                <option value="">— Niveau racine de l'activité —</option>
                <% sousActivitesDisponibles.forEach(function(sa) { %>
                    <option value="<%= sa.id %>"><%= sa.nom %></option>
                <% }) %>
            </select>
        <% } %>

        <div class="actions-form">
            <button type="submit" class="btn btn-primaire">Copier ici</button>
        </div>
    </form>
</div>
<script>
    function rechargerSousActivites() {
        var idActivite = document.getElementById('id_activite_destination').value;
        window.location.href = '/sous-activites/<%= sousActivite.id %>/copier?id_activite_destination=' + encodeURIComponent(idActivite);
    }
</script>
<% } %>

<%- include('../partials/footer') %>
