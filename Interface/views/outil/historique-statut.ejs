<%- include('../partials/header') %>

<div class="entete-page"><h1><i class="bi bi-graph-up-arrow"></i> Historique — <%= outil.nom %></h1></div>
<p style="color:var(--gris); font-size:14px; margin-top:-10px;">
 Adresse surveillée : <strong><%= outil.adresse %></strong>.
 Seuls les <strong>changements</strong> d'état sont enregistrés (pas chaque vérification).
</p>

<% if (!historique.length) { %>
 <div class="carte vide">Aucun changement de statut enregistré pour l'instant.</div>
<% } else { %>
 <div class="carte" style="max-width:520px;">
 <table class="tableau">
 <thead><tr><th>Date</th><th>Statut</th></tr></thead>
 <tbody>
 <% historique.forEach(function(h) { %>
 <tr>
 <td style="white-space:nowrap; font-size:13px; color:var(--gris);">
 <%= new Date(h.createdAt).toLocaleString('fr-FR') %>
 </td>
 <td>
 <% if (h.statut === 'en_ligne') { %>
 <span class="pastille-reseau en-ligne"><i class="bi bi-circle-fill text-statut-ok"></i> En ligne</span>
 <% } else { %>
 <span class="pastille-reseau hors-ligne"><i class="bi bi-circle-fill text-statut-ko"></i> Hors ligne</span>
 <% } %>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
<% } %>

<%- include('../partials/footer') %>
