<%- include('../partials/header') %>
<div class="entete-page">
  <h1><i class="bi bi-key"></i> Mes credentials — <%= outil.nom %></h1>
  <a href="<%= typeof retour !== 'undefined' && retour ? retour : '/' %>" class="btn btn-gris">Retour</a>
</div>

<% if (erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>
<% if (succes) { %><div class="message-succes"><%= succes %></div><% } %>

<div class="carte" style="max-width:640px;">
  <p style="color:var(--gris); font-size:13px;">
    Identifiants <strong>strictement personnels</strong> pour cet outil. Cochez « Copier à l’ouverture »
    pour coller automatiquement ce champ dans le presse-papier quand vous cliquez sur le lien de l’outil.
  </p>

  <%
    var creds = [];
    if (Array.isArray(outil.mes_credentials)) creds = outil.mes_credentials;
    else if (Array.isArray(outil.credentials)) creds = outil.credentials;
    if (!creds.length) creds = [{ label: 'Login', valeur: '', copier_ouverture: true }, { label: 'Mot de passe', valeur: '', copier_ouverture: true }];
  %>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
    <button type="button" class="btn btn-gris btn-petit" id="btn-toggle-all-creds">
      <i class="bi bi-eye"></i> Afficher / masquer tout
    </button>
  </div>

  <form action="/outils/<%= outil.id %>/credentials" method="POST" id="form-creds">
    <input type="hidden" name="retour" value="<%= typeof retour !== 'undefined' ? retour : '' %>">
    <input type="hidden" name="credentials" id="credentials-json" value="[]">

    <div id="creds-liste" class="creds-liste">
      <% creds.forEach(function(c, idx) { %>
      <div class="cred-ligne">
        <input type="text" class="cred-label" placeholder="Libellé" value="<%= c.label || '' %>">
        <div class="cred-valeur-wrap">
          <input type="password" class="cred-valeur" placeholder="Valeur" value="<%= c.valeur || '' %>" autocomplete="off">
          <button type="button" class="btn-icon btn-toggle-vis" title="Afficher / masquer"><i class="bi bi-eye"></i></button>
          <button type="button" class="btn-icon btn-copy-one" title="Copier ce champ"><i class="bi bi-clipboard"></i></button>
        </div>
        <label class="cred-copy-open" title="Copier ce champ à l’ouverture du lien de l’outil">
          <input type="checkbox" class="cred-copier-ouv" <%= (c.copier_ouverture !== false && c.copier_ouverture !== 0) ? 'checked' : '' %>>
          <span>Copier à l’ouverture</span>
        </label>
        <button type="button" class="btn-retirer" title="Retirer" onclick="this.closest('.cred-ligne').remove()">&times;</button>
      </div>
      <% }) %>
    </div>
    <button type="button" class="btn-ajouter-contact" id="btn-ajouter-cred">+ Ajouter un champ</button>

    <div class="actions-form" style="margin-top:18px;">
      <button type="submit" class="btn btn-primaire">Enregistrer</button>
      <a href="<%= typeof retour !== 'undefined' && retour ? retour : '/' %>" class="btn btn-gris">Annuler</a>
    </div>
  </form>
</div>

<style>
.creds-liste { display: flex; flex-direction: column; gap: 10px; }
.cred-ligne {
  display: grid;
  grid-template-columns: 1fr 1.4fr auto auto;
  gap: 8px;
  align-items: center;
  padding: 10px;
  border: 1px solid var(--gris-bordure, #e2e8f0);
  border-radius: 10px;
  background: #fff;
}
@media (max-width: 640px) {
  .cred-ligne { grid-template-columns: 1fr; }
}
.cred-valeur-wrap { display: flex; align-items: center; gap: 4px; }
.cred-valeur-wrap input { flex: 1; min-width: 0; }
.btn-icon {
  border: 1px solid var(--gris-bordure, #cbd5e1);
  background: #fff;
  border-radius: 8px;
  width: 34px; height: 34px;
  display: inline-flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--gris-fonce, #334155);
}
.btn-icon:hover { background: var(--gris-clair, #f1f5f9); }
.cred-copy-open {
  display: flex; align-items: center; gap: 4px;
  font-size: 11px; color: var(--gris, #64748b); white-space: nowrap;
  cursor: pointer;
}
.cred-copy-open input { margin: 0; }
</style>

<script>
(function () {
  function ligneHtml(label, valeur, copier) {
    return '<div class="cred-ligne">' +
      '<input type="text" class="cred-label" placeholder="Libellé" value="' + (label || '') + '">' +
      '<div class="cred-valeur-wrap">' +
      '<input type="password" class="cred-valeur" placeholder="Valeur" value="' + (valeur || '') + '" autocomplete="off">' +
      '<button type="button" class="btn-icon btn-toggle-vis" title="Afficher / masquer"><i class="bi bi-eye"></i></button>' +
      '<button type="button" class="btn-icon btn-copy-one" title="Copier ce champ"><i class="bi bi-clipboard"></i></button>' +
      '</div>' +
      '<label class="cred-copy-open"><input type="checkbox" class="cred-copier-ouv"' + (copier ? ' checked' : '') + '> <span>Copier à l’ouverture</span></label>' +
      '<button type="button" class="btn-retirer" onclick="this.closest(\'.cred-ligne\').remove()">&times;</button>' +
      '</div>';
  }

  function copierTexte(texte) {
    if (!texte) return;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(texte).then(function () {
        toast('Copié');
      }).catch(function () { fallback(texte); });
    } else {
      fallback(texte);
    }
  }
  function fallback(texte) {
    var ta = document.createElement('textarea');
    ta.value = texte;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      toast('Copié');
    } catch (e) {
      prompt('Copiez manuellement :', texte);
    }
    document.body.removeChild(ta);
  }
  function toast(msg) {
    var el = document.createElement('div');
    el.textContent = msg;
    el.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#0f172a;color:#fff;padding:10px 14px;border-radius:10px;z-index:9999;font-size:13px;';
    document.body.appendChild(el);
    setTimeout(function () { el.remove(); }, 1600);
  }

  var liste = document.getElementById('creds-liste');
  document.getElementById('btn-ajouter-cred').addEventListener('click', function () {
    liste.insertAdjacentHTML('beforeend', ligneHtml('', '', true));
  });

  document.getElementById('btn-toggle-all-creds').addEventListener('click', function () {
    var inputs = liste.querySelectorAll('.cred-valeur');
    var anyHidden = Array.prototype.some.call(inputs, function (i) { return i.type === 'password'; });
    inputs.forEach(function (i) { i.type = anyHidden ? 'text' : 'password'; });
    liste.querySelectorAll('.btn-toggle-vis i').forEach(function (ic) {
      ic.className = anyHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
    });
  });

  liste.addEventListener('click', function (e) {
    var btn = e.target.closest('.btn-toggle-vis');
    if (btn) {
      var input = btn.parentElement.querySelector('.cred-valeur');
      if (!input) return;
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      var ic = btn.querySelector('i');
      if (ic) ic.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
      return;
    }
    var copyBtn = e.target.closest('.btn-copy-one');
    if (copyBtn) {
      var wrap = copyBtn.closest('.cred-ligne');
      var v = wrap.querySelector('.cred-valeur');
      copierTexte(v ? v.value : '');
    }
  });

  document.getElementById('form-creds').addEventListener('submit', function () {
    var arr = [];
    liste.querySelectorAll('.cred-ligne').forEach(function (ligne) {
      var label = (ligne.querySelector('.cred-label') || {}).value || '';
      var valeur = (ligne.querySelector('.cred-valeur') || {}).value || '';
      var copier = !!(ligne.querySelector('.cred-copier-ouv') || {}).checked;
      if (label || valeur) arr.push({ label: label, valeur: valeur, copier_ouverture: copier });
    });
    document.getElementById('credentials-json').value = JSON.stringify(arr);
  });
})();
</script>
<%- include('../partials/footer') %>
