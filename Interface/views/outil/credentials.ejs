<%- include('../partials/header') %>

<div class="fil-ariane">
    <a href="<%= retour %>">Retour</a> <span class="sep">›</span> Credentials — <%= outil.nom %>
</div>
<div class="entete-page"><h1>🔑 Credentials — <%= outil.nom %></h1></div>

<% if (erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>
<% if (succes) { %><div class="message-succes"><%= succes %></div><% } %>

<div class="carte" style="max-width:560px;">
    <p style="color:var(--gris); font-size:13px; margin-top:-4px;">
        Ajoutez les identifiants de connexion de cet outil (login, mot de passe, clé API, token…).
        Ils pourront être copiés d’un clic depuis la liste des outils ou à l’ouverture du lien.
    </p>

    <%
      var creds = [];
      if (Array.isArray(outil.credentials)) creds = outil.credentials;
      else if (typeof outil.credentials === 'string' && outil.credentials) {
        try { creds = JSON.parse(outil.credentials); } catch(_) {}
      }
      if (!creds.length) creds = [{ label: 'Login', valeur: '' }, { label: 'Mot de passe', valeur: '' }];
    %>

    <form action="/outils/<%= outil.id %>/credentials" method="POST" id="form-creds">
        <input type="hidden" name="retour" value="<%= retour %>">
        <input type="hidden" name="credentials" id="credentials-json" value="[]">

        <div id="creds-liste" class="contacts-liste">
            <% creds.forEach(function(c) { %>
            <div class="contact-ligne">
                <input type="text" class="cred-label" placeholder="Libellé (ex. Login)" value="<%= c.label || '' %>" style="flex:1;">
                <input type="text" class="cred-valeur" placeholder="Valeur" value="<%= c.valeur || '' %>" style="flex:1.2;">
                <button type="button" class="btn-retirer" title="Retirer" onclick="this.parentElement.remove()">&times;</button>
                <% if (c.valeur) { %>
                <button type="button" class="btn btn-gris btn-petit" title="Copier la valeur"
                        onclick="gloCopier(this.previousElementSibling.previousElementSibling ? this.parentElement.querySelector('.cred-valeur').value : '')">📋</button>
                <% } %>
            </div>
            <% }) %>
        </div>
        <button type="button" class="btn-ajouter-contact" id="btn-ajouter-cred">+ Ajouter un champ</button>

        <div class="actions-form" style="margin-top:18px;">
            <button type="submit" class="btn btn-primaire">Enregistrer</button>
            <a href="<%= retour %>" class="btn btn-gris">Retour</a>
        </div>
    </form>

    <% if (outil.lien) { %>
    <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
    <p style="font-size:14px;">
        <a href="<%= outil.lien %>" target="_blank" rel="noopener" class="btn btn-accent" id="btn-ouvrir-avec-copie">
            Ouvrir l'outil ↗
        </a>
        <span style="color:var(--gris); font-size:12px; margin-left:8px;">Les valeurs sont copiables individuellement ci-dessus.</span>
    </p>
    <% } %>
</div>

<script>
(function () {
    var liste = document.getElementById('creds-liste');
    document.getElementById('btn-ajouter-cred').onclick = function () {
        var div = document.createElement('div');
        div.className = 'contact-ligne';
        div.innerHTML =
            '<input type="text" class="cred-label" placeholder="Libellé (ex. Login)" value="" style="flex:1;">' +
            '<input type="text" class="cred-valeur" placeholder="Valeur" value="" style="flex:1.2;">' +
            '<button type="button" class="btn-retirer" title="Retirer" onclick="this.parentElement.remove()">&times;</button>';
        liste.appendChild(div);
    };

    document.getElementById('form-creds').addEventListener('submit', function () {
        var rows = liste.querySelectorAll('.contact-ligne');
        var creds = [];
        rows.forEach(function (row) {
            var label = (row.querySelector('.cred-label').value || '').trim();
            var valeur = (row.querySelector('.cred-valeur').value || '').trim();
            if (label || valeur) creds.push({ label: label || 'Champ', valeur: valeur });
        });
        document.getElementById('credentials-json').value = JSON.stringify(creds);
    });

    var btnOuvrir = document.getElementById('btn-ouvrir-avec-copie');
    if (btnOuvrir) {
        btnOuvrir.addEventListener('click', function () {
            var rows = liste.querySelectorAll('.contact-ligne');
            var parts = [];
            rows.forEach(function (row) {
                var label = (row.querySelector('.cred-label').value || '').trim();
                var valeur = (row.querySelector('.cred-valeur').value || '').trim();
                if (valeur) parts.push((label || 'Champ') + ' : ' + valeur);
            });
            if (parts.length && typeof gloCopier === 'function') {
                gloCopier(parts.join('\\n'));
            }
        });
    }
})();
</script>

<%- include('../partials/footer') %>
