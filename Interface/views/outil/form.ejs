<%- include('../partials/header') %>
<% var estEdition = !!(typeof outil !== 'undefined' && outil && outil.id); %>
<div class="entete-page"><h1><%= titre %></h1></div>

<div class="carte" style="max-width:560px;">
 <% if (erreur) { %>
 <div class="message-erreur"><%= erreur %></div>
 <% } %>
 <% if (!estEdition) { %>
 <p style="color:var(--gris); font-size:13px; margin-top:-4px;">
 Renseignez le nom de l'outil ainsi que, le cas échéant, son URL d'accès et son adresse réseau (IP ou nom d'hôte) pour le diagnostic.
 </p>
 <% } %>

 <form action="<%= estEdition ? '/outils/' + outil.id + '/modifier' : '/outils' %>" method="POST" enctype="multipart/form-data" id="form-outil">
 <input type="hidden" name="id_activite" value="<%= id_activite %>">
 <input type="hidden" name="retour" value="<%= typeof retour !== 'undefined' ? retour : '/' %>">
 
 <label for="nom">Nom de l'outil</label>
 <input type="text" id="nom" name="nom" required value="<%= estEdition ? (outil.nom || '') : '' %>">

 <label for="lien">Lien (optionnel)</label>
 <input type="url" id="lien" name="lien" placeholder="https://..." value="<%= estEdition ? (outil.lien || '') : '' %>">

 <label for="adresse">Adresse IP / nom d'hôte (optionnel)</label>
 <input type="text" id="adresse" name="adresse" placeholder="192.168.1.10 ou routeur.local" value="<%= estEdition ? (outil.adresse || '') : '' %>">
 <p style="color:var(--gris); font-size:13px; margin-top:-6px;">
 Permet de tester la joignabilité de l'outil (ping, traceroute...) depuis l'onglet Diagnostic réseau.
 </p>

 <label>Propriétaire</label>
 <p style="margin:4px 0 0; padding:9px 11px; background:var(--gris-clair); border-radius:var(--rayon); font-size:14px;">
 <%= currentUser.prenom %> <%= currentUser.nom %> <span style="color:var(--gris);">(vous)</span>
 </p>

 <label for="id_sous_activite">Sous-activité (optionnel)</label>
 <select id="id_sous_activite" name="id_sous_activite">
 <option value="">— Aucune —</option>
 <% sousActivites.forEach(function(sa) { %>
 <option value="<%= sa.id %>" <%= String(sa.id) === String(id_sous_activite) ? 'selected' : '' %>><%= sa.nom %></option>
 <% }) %>
 </select>

 <label for="image">Image (optionnel)</label>
 <input type="file" id="image" name="image" accept="image/*">
<div class="actions-form" style="margin-top:18px;">
 <button type="submit" class="btn btn-primaire"><%= estEdition ? "Enregistrer" : "Créer" %></button>
 <a href="<%= id_activite ? '/activites/' + id_activite + '?onglet=outils' : '/' %>" class="btn btn-gris">Annuler</a>
 </div>
 </form>
</div>

<script>
(function () {
 var liste = document.getElementById('creds-liste');
 function ligne(label, valeur) {
 var div = document.createElement('div');
 div.className = 'contact-ligne';
 div.innerHTML =
 '<input type="text" class="cred-label" placeholder="Libellé (ex. Login)" value="' + (label || '') + '" style="flex:1;">' +
 '<input type="text" class="cred-valeur" placeholder="Valeur" value="' + (valeur || '') + '" style="flex:1.2;">' +
 '<button type="button" class="btn-retirer" title="Retirer">&times;</button>';
 div.querySelector('.btn-retirer').onclick = function () { div.remove(); };
 liste.appendChild(div);
 }
 document.getElementById('btn-ajouter-cred').onclick = function () { ligne('', ''); };
 // Deux champs par défaut
 ligne('Login', '');
 ligne('Mot de passe', '');

 document.getElementById('form-outil').addEventListener('submit', function () {
 var rows = liste.querySelectorAll('.contact-ligne');
 var creds = [];
 rows.forEach(function (row) {
 var label = (row.querySelector('.cred-label').value || '').trim();
 var valeur = (row.querySelector('.cred-valeur').value || '').trim();
 if (label || valeur) creds.push({ label: label || 'Champ', valeur: valeur });
 });
 document.getElementById('credentials-json').value = JSON.stringify(creds);
 });
})();
</script>

<%- include('../partials/footer') %>
