<%- include('../partials/header') %>

<div class="entete-page"><h1>Accès particuliers</h1></div>
<p style="color:var(--gris); font-size:14px; margin-top:-10px;">
 Le <strong>rôle</strong> (page Rôles) définit ce qu'un utilisateur peut faire en général.
 L'<strong>accès particulier</strong> ci-dessous définit où il peut le faire, en dehors de
 son activité principale :
</p>
<ul style="color:var(--gris); font-size:14px; margin-top:-6px; padding-left:20px;">
 <li><strong>Lecture</strong> (toujours accordée) : voir l'activité/sous-activité sur le tableau de bord et y naviguer.</li>
 <li><strong>Écriture</strong> : y créer/modifier des sous-activités, des outils, et modifier l'activité elle-même.</li>
 <li><strong>Suppression</strong> : y supprimer des sous-activités ou des outils.</li>
</ul>
<p style="color:var(--gris); font-size:14px; margin-top:-6px;">
 Un accès accordé sur une activité entière couvre aussi toutes ses sous-activités ;
 un accès accordé sur une sous-activité précise couvre elle et ses sous-activités enfants,
 mais pas le reste de l'activité.
</p>

<% if (peut('acces', 'create')) { %>
<div class="carte" style="max-width:640px;">
 <form action="/acces" method="POST">
 <label for="id_user">Utilisateur</label>
 <select id="id_user" name="id_user" required>
 <option value="">— Choisir —</option>
 <% utilisateurs.forEach(function(u) { %>
 <option value="<%= u.id %>" <%= String(id_user_selectionne) === String(u.id) ? 'selected' : '' %>><%= u.prenom %> <%= u.nom %> (<%= u.matricule %>)</option>
 <% }) %>
 </select>

 <label for="id_activite">Activité</label>
 <select id="id_activite" name="id_activite" required onchange="rechargerSousActivites()">
 <option value="">— Choisir —</option>
 <% activites.forEach(function(a) { %>
 <option value="<%= a.id %>" <%= String(id_activite) === String(a.id) ? 'selected' : '' %>><%= a.nom %></option>
 <% }) %>
 </select>

 <% if (id_activite && sousActivitesDisponibles.length) { %>
 <label for="id_sous_activite">Sous-activité précise (optionnel)</label>
 <select id="id_sous_activite" name="id_sous_activite">
 <option value="">— Toute l'activité —</option>
 <% sousActivitesDisponibles.forEach(function(sa) { %>
 <option value="<%= sa.id %>"><%= sa.nom %></option>
 <% }) %>
 </select>
 <p style="color:var(--gris); font-size:12px; margin-top:-6px;">
 Laisser sur « Toute l'activité » pour un accès qui couvre aussi ses sous-activités.
 </p>
 <% } %>

 <div class="champ-case">
 <input type="checkbox" id="write" name="write">
 <label for="write">Autoriser l'écriture (création/modification)</label>
 </div>
 <div class="champ-case">
 <input type="checkbox" id="delete" name="delete">
 <label for="delete">Autoriser la suppression</label>
 </div>

 <div class="actions-form">
 <button type="submit" class="btn btn-primaire">Accorder l'accès</button>
 </div>
 </form>
</div>
<script>
 // On recharge simplement avec l'activité choisie : le serveur renvoie
 // alors ses sous-activités (s'il y en a) pour affiner l'accès.
 function rechargerSousActivites() {
 var idActivite = document.getElementById('id_activite').value;
 var idUser = document.getElementById('id_user').value;
 var url = '/acces?id_activite=' + encodeURIComponent(idActivite);
 if (idUser) url += '&id_user=' + encodeURIComponent(idUser);
 window.location.href = url;
 }
</script>
<% } %>

<div class="carte">
 <h2 style="margin-top:0; font-size:16px; color:var(--bleu-fonce);">Accès sur des activités</h2>
 <% if (!accesActivites.length) { %>
 <p class="vide">Aucun accès particulier accordé.</p>
 <% } else { %>
 <table class="tableau">
 <thead><tr><th>Utilisateur</th><th>Activité</th><th>Niveau</th><th></th></tr></thead>
 <tbody>
 <% accesActivites.forEach(function(a) { %>
 <tr>
 <td><%= a.Utilisateur ? a.Utilisateur.prenom + ' ' + a.Utilisateur.nom : '—' %></td>
 <td><%= a.Activite ? a.Activite.nom : '—' %></td>
 <td>
 <%= a.permissions && a.permissions.write ? 'Écriture' : 'Lecture' %><% if (a.permissions && a.permissions.delete) { %> + Suppression<% } %>
 </td>
 <td style="text-align:right;">
 <% if (peut('acces', 'delete')) { %>
 <form action="/acces/activites/<%= a.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Révoquer cet accès ?');">
 <button type="submit" class="btn btn-danger btn-petit">Révoquer</button>
 </form>
 <% } %>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 <% } %>
</div>

<div class="carte">
 <h2 style="margin-top:0; font-size:16px; color:var(--bleu-fonce);">Accès sur des sous-activités</h2>
 <% if (!accesSousActivites.length) { %>
 <p class="vide">Aucun accès particulier accordé (voir aussi l'onglet "Utilisateurs" de chaque sous-activité).</p>
 <% } else { %>
 <table class="tableau">
 <thead><tr><th>Utilisateur</th><th>Sous-activité</th><th>Niveau</th><th></th></tr></thead>
 <tbody>
 <% accesSousActivites.forEach(function(a) { %>
 <tr>
 <td><%= a.Utilisateur ? a.Utilisateur.prenom + ' ' + a.Utilisateur.nom : '—' %></td>
 <td><%= a.SousActivite ? a.SousActivite.nom : '—' %></td>
 <td>
 <%= a.permissions && a.permissions.write ? 'Écriture' : 'Lecture' %><% if (a.permissions && a.permissions.delete) { %> + Suppression<% } %>
 </td>
 <td style="text-align:right;">
 <% if (peut('acces', 'delete')) { %>
 <form action="/acces/sous-activites/<%= a.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Révoquer cet accès ?');">
 <button type="submit" class="btn btn-danger btn-petit">Révoquer</button>
 </form>
 <% } %>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 <% } %>
</div>


<script>
(function () {
  var RECENT_KEY = 'glo_acces_recent';
  function getRecent(kind) {
    try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '{}')[kind] || []; } catch (e) { return []; }
  }
  function pushRecent(kind, id, label) {
    var all = {};
    try { all = JSON.parse(localStorage.getItem(RECENT_KEY) || '{}'); } catch (e) {}
    var list = (all[kind] || []).filter(function (x) { return String(x.id) !== String(id); });
    list.unshift({ id: String(id), label: label });
    all[kind] = list.slice(0, 8);
    localStorage.setItem(RECENT_KEY, JSON.stringify(all));
  }

  function enhanceSelect(sel, kind) {
    if (!sel || sel.dataset.enhanced) return;
    sel.dataset.enhanced = '1';
    sel.style.display = 'none';

    var options = Array.prototype.map.call(sel.options, function (o) {
      return { value: o.value, text: o.textContent.trim() };
    });

    var wrap = document.createElement('div');
    wrap.className = 'glo-acces-combo';
    wrap.style.cssText = 'position:relative;min-width:220px;';

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'glo-acces-combo-btn';
    btn.style.cssText = 'width:100%;text-align:left;padding:8px 10px;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:8px;background:#fff;cursor:pointer;font-size:13px;';
    function currentLabel() {
      var v = sel.value;
      var o = options.find(function (x) { return String(x.value) === String(v); });
      return o ? o.text : '—';
    }
    btn.textContent = currentLabel();

    var panel = document.createElement('div');
    panel.hidden = true;
    panel.style.cssText = 'position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:50;background:#fff;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);padding:8px;max-height:280px;overflow:auto;';

    var search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Rechercher…';
    search.style.cssText = 'width:100%;box-sizing:border-box;margin-bottom:6px;padding:7px 9px;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:8px;font-size:13px;';

    var list = document.createElement('div');

    function pick(value, label) {
      sel.value = value;
      btn.textContent = label || currentLabel();
      panel.hidden = true;
      if (value) pushRecent(kind, value, label);
      // Déclencher change (ex. recharger sous-activités)
      var ev = document.createEvent('HTMLEvents');
      ev.initEvent('change', true, false);
      sel.dispatchEvent(ev);
    }

    function render(q) {
      q = (q || '').trim().toLowerCase();
      list.innerHTML = '';
      var recent = getRecent(kind);
      var shown = {};

      function addItem(value, text, meta) {
        if (shown[String(value)] && value !== '') return;
        shown[String(value)] = true;
        var b = document.createElement('button');
        b.type = 'button';
        b.style.cssText = 'display:block;width:100%;text-align:left;padding:7px 9px;border:none;background:transparent;border-radius:6px;cursor:pointer;font-size:13px;';
        b.textContent = text + (meta ? ' · ' + meta : '');
        if (String(sel.value) === String(value)) b.style.background = 'var(--bleu-clair,#eff6ff)';
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          pick(value, text);
        });
        list.appendChild(b);
      }

      // Options vides en premier
      options.filter(function (o) { return !o.value; }).forEach(function (o) {
        addItem(o.value, o.text);
      });
      // Récents
      recent.forEach(function (r) {
        if (!r.id) return;
        var match = options.find(function (o) { return String(o.value) === String(r.id); });
        if (!match) return;
        if (q && String(match.text).toLowerCase().indexOf(q) < 0) return;
        addItem(match.value, match.text, 'récent');
      });
      // Reste filtré
      options.forEach(function (o) {
        if (!o.value) return;
        if (q && o.text.toLowerCase().indexOf(q) < 0 && String(o.value).indexOf(q) < 0) return;
        addItem(o.value, o.text);
      });
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      document.querySelectorAll('.glo-acces-combo div[data-panel]').forEach(function (p) { p.hidden = true; });
      panel.hidden = !open;
      if (!panel.hidden) {
        render(search.value);
        setTimeout(function () { search.focus(); }, 10);
      }
    });
    search.addEventListener('input', function () { render(search.value); });
    search.addEventListener('click', function (e) { e.stopPropagation(); });
    panel.setAttribute('data-panel', '1');
    panel.appendChild(search);
    panel.appendChild(list);
    wrap.appendChild(btn);
    wrap.appendChild(panel);
    sel.parentNode.insertBefore(wrap, sel);
    wrap.appendChild(sel);
  }

  document.addEventListener('click', function () {
    document.querySelectorAll('.glo-acces-combo div[data-panel]').forEach(function (p) { p.hidden = true; });
  });

  enhanceSelect(document.getElementById('id_user'), 'user');
  enhanceSelect(document.getElementById('id_activite'), 'activite');
  enhanceSelect(document.getElementById('id_sous_activite'), 'sous');
})();
</script>


<%- include('../partials/footer') %>
