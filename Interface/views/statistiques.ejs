<%- include('partials/header') %>

<div class="entete-page"><h1><i class="bi bi-bar-chart"></i> Statistiques</h1></div>
<p style="color:var(--gris); font-size:14px; margin-top:-10px;">Vue d'ensemble de tout le parc (tous périmètres confondus).</p>

<div class="grille-stats">
 <div class="carte-stat">
 <span class="valeur-stat"><%= stats.nbActivites %></span>
 <span class="libelle-stat">Activités</span>
 </div>
 <div class="carte-stat">
 <span class="valeur-stat"><%= stats.nbSousActivites %></span>
 <span class="libelle-stat">Sous-activités</span>
 </div>
 <div class="carte-stat">
 <span class="valeur-stat"><%= stats.nbUtilisateurs %></span>
 <span class="libelle-stat">Utilisateurs</span>
 </div>
 <div class="carte-stat">
 <span class="valeur-stat"><%= stats.nbOutilsActifs %></span>
 <span class="libelle-stat">Outils actifs</span>
 </div>
 <div class="carte-stat">
 <span class="valeur-stat"><%= stats.nbOutilsArchives %></span>
 <span class="libelle-stat">Outils archivés</span>
 </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-top:8px;">

 <div class="carte">
 <h2 style="margin-top:0; font-size:15px; color:var(--bleu-fonce);"><i class="bi bi-heart-pulse"></i> Surveillance réseau</h2>
 <% if (!stats.nbOutilsSurveilles) { %>
 <p class="vide">Aucun outil n'a d'adresse renseignée pour l'instant.</p>
 <% } else { %>
 <div style="display:flex; gap:10px; flex-wrap:wrap;">
 <span class="pastille-reseau en-ligne" style="font-size:13px; padding:5px 12px;"><i class="bi bi-circle-fill text-statut-ok"></i> <%= stats.nbOutilsEnLigne %> en ligne</span>
 <span class="pastille-reseau hors-ligne" style="font-size:13px; padding:5px 12px;"><i class="bi bi-circle-fill text-statut-ko"></i> <%= stats.nbOutilsHorsLigne %> hors ligne</span>
 <span class="pastille-reseau inconnu" style="font-size:13px; padding:5px 12px;"><i class="bi bi-circle text-statut-na"></i> <%= stats.nbOutilsSurveilles - stats.nbOutilsEnLigne - stats.nbOutilsHorsLigne %> non vérifiés</span>
 </div>
 <p style="color:var(--gris); font-size:13px; margin-top:12px; margin-bottom:0;">
 <%= stats.nbOutilsSurveilles %> outil(s) surveillé(s) sur <%= stats.nbOutilsActifs + stats.nbOutilsArchives %> au total.
 </p>
 <% } %>
 </div>

 <div class="carte">
 <h2 style="margin-top:0; font-size:15px; color:var(--bleu-fonce);"><i class="bi bi-people"></i> Répartition par rôle</h2>
 <% if (!stats.repartitionRoles.length) { %>
 <p class="vide">Aucun utilisateur.</p>
 <% } else { %>
 <% var maxRole = Math.max.apply(null, stats.repartitionRoles.map(function(r){ return r.total; })); %>
 <% stats.repartitionRoles.forEach(function(r) { %>
 <div style="margin-bottom:10px;">
 <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:3px;">
 <span><%= r.nom %></span>
 <span style="color:var(--gris);"><%= r.total %></span>
 </div>
 <div style="background:var(--gris-clair); border-radius:6px; height:8px; overflow:hidden;">
 <div style="background:var(--bleu); height:100%; width:<%= maxRole ? Math.round((r.total / maxRole) * 100) : 0 %>%;"></div>
 </div>
 </div>
 <% }) %>
 <% } %>
 </div>

</div>

<div class="carte" style="margin-top:20px;">
 <h2 style="margin-top:0; font-size:15px; color:var(--bleu-fonce);"><i class="bi bi-clock-history"></i> Activité récente</h2>
 <% if (!stats.activiteRecente.length) { %>
 <p class="vide">Aucun événement pour l'instant.</p>
 <% } else { %>
 <table class="tableau">
 <thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Détail</th></tr></thead>
 <tbody>
 <% stats.activiteRecente.forEach(function(e) { %>
 <tr>
 <td style="white-space:nowrap; font-size:13px; color:var(--gris);">
 <%= new Date(e.createdAt).toLocaleString('fr-FR') %>
 </td>
 <td><%= e.nom_user || 'Système' %></td>
 <td><span class="badge-role" style="background:var(--bleu);"><%= e.action %></span></td>
 <td><%= e.libelle %></td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 <div style="margin-top:12px;">
 <a href="/journal" class="btn btn-gris btn-petit">Voir tout le journal <i class="bi bi-arrow-right"></i> </a>
 </div>
 <% } %>
</div>

<%- include('partials/footer') %>
