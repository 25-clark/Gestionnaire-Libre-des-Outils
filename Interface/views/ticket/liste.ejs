<%- include('../partials/header') %>

<div class="entete-page">
 <h1><i class="bi bi-ticket-detailed"></i> Tickets</h1>
 <div style="display:flex; gap:8px; flex-wrap:wrap;">
 <% if (peut('export', 'read')) { %>
 <a href="/tickets/export.csv?statut=<%= statut %>&priorite=<%= priorite %>&id_createur=<%= id_createur %>&id_assigne=<%= id_assigne %>" class="btn btn-gris btn-petit"><i class="bi bi-download"></i> CSV</a>
 <a href="/tickets/export-pdf?statut=<%= statut %>&priorite=<%= priorite %>&id_createur=<%= id_createur %>&id_assigne=<%= id_assigne %>" target="_blank" class="btn btn-gris btn-petit"><i class="bi bi-printer"></i> PDF</a>
 <% } %>
 <% if (peut('tickets', 'create')) { %>
 <a href="/tickets/nouveau" class="btn btn-accent">+ Nouveau ticket</a>
 <% } %>
 </div>
</div>

<%
 var filtresActifs = [];
 if (statut) filtresActifs.push({ cle: 'statut', libelle: 'Statut', valeur: LIBELLES_STATUT[statut] || statut });
 if (priorite) filtresActifs.push({ cle: 'priorite', libelle: 'Priorité', valeur: LIBELLES_PRIORITE[priorite] || priorite });
 if (id_createur) {
 var uC = utilisateurs.find(function(u) { return String(u.id) === String(id_createur); });
 var libC = (currentUser && String(id_createur) === String(currentUser.id)) ? 'Moi' : (uC ? (uC.prenom + ' ' + uC.nom) : ('#' + id_createur));
 filtresActifs.push({ cle: 'id_createur', libelle: 'Créé par', valeur: libC });
 }
 if (id_assigne) {
 var uA = utilisateurs.find(function(u) { return String(u.id) === String(id_assigne); });
 var libA = (currentUser && String(id_assigne) === String(currentUser.id)) ? 'Moi' : (uA ? (uA.prenom + ' ' + uA.nom) : ('#' + id_assigne));
 filtresActifs.push({ cle: 'id_assigne', libelle: 'Assigné à', valeur: libA });
 }
%>

<div class="carte carte-filtres-tickets" id="carte-filtres-tickets" style="margin-bottom:16px;padding:0;overflow:hidden;">
 <button type="button" class="filtres-collapse-btn" id="btn-toggle-filtres" aria-expanded="true" aria-controls="filtres-corps">
   <span class="filtres-collapse-titre">
     <i class="bi bi-funnel"></i> Filtres
     <span class="filtres-collapse-hint" style="font-weight:400;color:var(--gris);font-size:12px;margin-left:6px;">critères enregistrés automatiquement</span>
   </span>
   <i class="bi bi-chevron-up" id="icone-toggle-filtres" aria-hidden="true"></i>
 </button>
 <div id="filtres-corps" class="filtres-corps">
 <form action="/tickets" method="GET" id="form-filtres-tickets" class="form-filtres-tickets" style="padding:12px 14px 14px;">
 <p style="font-size:12px;color:var(--gris);margin:0 0 8px;">
   Réglez les critères puis <strong>Appliquer les filtres</strong> — ils restent actifs à chaque visite.
 </p>
 <div id="blocs-filtres" class="blocs-filtres"></div>
 <div style="margin:10px 0;">
   <button type="button" class="btn btn-gris btn-petit" id="btn-ajouter-filtre">
     <i class="bi bi-plus-lg"></i> Ajouter un filtre
   </button>
 </div>
 <!-- champs techniques remplis à la soumission -->
 <input type="hidden" name="statut" id="hid-statut" value="<%= statut || '' %>">
 <input type="hidden" name="priorite" id="hid-priorite" value="<%= priorite || '' %>">
 <input type="hidden" name="id_createur" id="hid-id_createur" value="<%= id_createur || '' %>">
 <input type="hidden" name="id_assigne" id="hid-id_assigne" value="<%= id_assigne || '' %>">
 <input type="hidden" name="q" id="hid-q" value="<%= typeof q !== 'undefined' && q ? q : '' %>">

 <div class="filtres-actions">
 <div>
 <label for="par_page" style="font-size:12px;color:var(--gris);">Par page</label>
 <select id="par_page" name="par_page">
 <% [10, 25, 50, 100].forEach(function(n) { %>
 <option value="<%= n %>" <%= Number(typeof par_page !== 'undefined' ? par_page : 25) === n ? 'selected' : '' %>><%= n %></option>
 <% }) %>
 </select>
 </div>
 <button type="submit" class="btn btn-primaire" title="Appliquer tous les filtres sélectionnés">
 <i class="bi bi-funnel"></i> Appliquer les filtres
 </button>
 <a href="/tickets?reset=1" class="btn btn-gris" id="btn-reset-filtres">Réinitialiser</a>
 </div>
 </form>
 </div>
</div>

<style>
.carte-filtres-tickets .filtres-collapse-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 14px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  color: var(--bleu-fonce, #1e3a5f);
  text-align: left;
}
.carte-filtres-tickets .filtres-collapse-btn:hover {
  background: var(--gris-clair, #f1f5f9);
}
.carte-filtres-tickets.replié .filtres-corps {
  display: none;
}
.carte-filtres-tickets.replié #icone-toggle-filtres {
  transform: rotate(180deg);
}
#icone-toggle-filtres {
  transition: transform 0.2s ease;
  font-size: 1rem;
  color: var(--gris, #64748b);
}
.form-filtres-tickets .filtres-selects {
 display: flex;
 gap: 10px;
 flex-wrap: wrap;
 align-items: flex-end;
}
.form-filtres-tickets .filtres-selects > div {
 min-width: 140px;
 flex: 1 1 140px;
}
.form-filtres-tickets .filtres-selects label {
 display: block;
 font-size: 12px;
 margin-bottom: 4px;
 color: var(--gris);
}
.form-filtres-tickets .filtres-actions {
 display: flex;
 gap: 8px;
 flex-wrap: wrap;
 margin-top: 12px;
 align-items: center;
}
.pastille-filtre {
 display: inline-flex;
 align-items: center;
 gap: 6px;
 background: var(--bleu-clair);
 color: var(--bleu-fonce);
 padding: 4px 10px;
 border-radius: 16px;
 font-size: 12px;
 margin: 2px 4px 2px 0;
}
.pastille-filtre .retirer-filtre {
 color: var(--rouge);
 text-decoration: none;
 font-weight: 700;
 font-size: 14px;
 line-height: 1;
}
.pastille-filtre .retirer-filtre:hover { opacity: 0.7; }
.btn-filtre-sauve {
 display: inline-flex;
 align-items: center;
 gap: 4px;
 background: var(--gris-clair);
 border: 1px solid var(--gris-bordure);
 border-radius: 16px;
 padding: 4px 10px;
 font-size: 12px;
 cursor: pointer;
 color: var(--gris-fonce);
}
.btn-filtre-sauve:hover { background: var(--bleu-clair); border-color: var(--bleu); }
.btn-filtre-sauve .suppr {
 color: var(--rouge);
 margin-left: 4px;
 font-weight: 700;
}
</style>

<script type="application/json" id="glo-tickets-data">
<%
  var _gloTicketsData = {
    libStatut: LIBELLES_STATUT,
    libPriorite: LIBELLES_PRIORITE,
    users: (utilisateurs || []).map(function(u) { return { id: u.id, label: (u.prenom || '') + ' ' + (u.nom || '') }; }),
    currentId: currentUser ? String(currentUser.id) : '',
    initial: {
      statut: statut || '',
      priorite: priorite || '',
      id_createur: id_createur || '',
      id_assigne: id_assigne || '',
      q: (typeof q !== 'undefined' && q) ? q : ''
    }
  };
%>
<%- JSON.stringify(_gloTicketsData) %>
</script>
<script>
(function () {

  // Collapse carte filtres (mémorisé)
  (function () {
    var carte = document.getElementById('carte-filtres-tickets');
    var btn = document.getElementById('btn-toggle-filtres');
    var icon = document.getElementById('icone-toggle-filtres');
    if (!carte || !btn) return;
    var KEY = 'glo_tickets_filtres_replies';
    function apply(replié) {
      carte.classList.toggle('replié', !!replié);
      btn.setAttribute('aria-expanded', replié ? 'false' : 'true');
      try { localStorage.setItem(KEY, replié ? '1' : '0'); } catch (_) {}
    }
    try {
      if (localStorage.getItem(KEY) === '1') apply(true);
    } catch (_) {}
    btn.addEventListener('click', function () {
      apply(!carte.classList.contains('replié'));
    });
  })();

  var STORAGE_KEY = 'glo_filtres_tickets_actifs';
  var RECENT_KEY = 'glo_tickets_users_recent';
  var _raw = document.getElementById('glo-tickets-data');
  var _data = {};
  try { _data = JSON.parse(_raw ? _raw.textContent : '{}'); } catch (e) { _data = {}; }
  var LIB_STATUT = _data.libStatut || {};
  var LIB_PRIORITE = _data.libPriorite || {};
  var USERS = _data.users || [];
  var CURRENT_ID = _data.currentId || '';
  var initial = _data.initial || { statut: '', priorite: '', id_createur: '', id_assigne: '', q: '' };

  var blocs = document.getElementById('blocs-filtres');
  var blocIndex = 0;
  var form = document.getElementById('form-filtres-tickets');

  function getActifs() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch (_) { return {}; }
  }
  function setActifs(obj) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(obj || {}));
  }
  function getRecentUsers() {
    try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch (_) { return []; }
  }
  function pushRecentUser(id, label) {
    if (!id) return;
    var list = getRecentUsers().filter(function (u) { return String(u.id) !== String(id); });
    list.unshift({ id: String(id), label: label || ('#' + id) });
    localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, 8)));
  }

  // Restauration auto sans boucle :
  // - si URL sans critères mais localStorage rempli → 1 redirect avec ?_r=1
  // - si déjà ?_r=1 → plus de redirect, on préremplit seulement l'UI
  var params = new URLSearchParams(window.location.search);
  if (params.get('reset') === '1') {
    setActifs({});
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/tickets');
    }
    initial = { statut: '', priorite: '', id_createur: '', id_assigne: '', q: '' };
  } else {
    var hasUrl = !!(initial.statut || initial.priorite || initial.id_createur || initial.id_assigne || initial.q);
    if (hasUrl) {
      setActifs({
        statut: initial.statut || '',
        priorite: initial.priorite || '',
        id_createur: initial.id_createur || '',
        id_assigne: initial.id_assigne || '',
        q: initial.q || '',
        par_page: params.get('par_page') || ''
      });
      // Nettoyer le marqueur _r dans l'URL si présent
      if (params.get('_r') && window.history && window.history.replaceState) {
        params.delete('_r');
        var clean = params.toString();
        window.history.replaceState({}, '', '/tickets' + (clean ? ('?' + clean) : ''));
      }
    } else {
      var saved = getActifs();
      var hasSaved = !!(saved && (saved.statut || saved.priorite || saved.id_createur || saved.id_assigne));
      if (hasSaved && params.get('_r') !== '1') {
        var q = new URLSearchParams();
        ['statut', 'priorite', 'id_createur', 'id_assigne', 'q'].forEach(function (k) {
          if (saved[k]) q.set(k, saved[k]);
        });
        if (saved.par_page) q.set('par_page', saved.par_page);
        q.set('_r', '1');
        window.location.replace('/tickets?' + q.toString());
        return;
      }
      if (hasSaved) {
        initial = {
          statut: saved.statut || '',
          priorite: saved.priorite || '',
          id_createur: saved.id_createur || '',
          id_assigne: saved.id_assigne || '',
          q: saved.q || ''
        };
      }
    }
  }

  function optsStatut(sel) {
    var h = '<option value="">— Tous —</option>';
    Object.keys(LIB_STATUT).forEach(function (k) {
      h += '<option value="' + k + '"' + (sel === k ? ' selected' : '') + '>' + LIB_STATUT[k] + '</option>';
    });
    return h;
  }
  function optsPriorite(sel) {
    var h = '<option value="">— Toutes —</option>';
    Object.keys(LIB_PRIORITE).forEach(function (k) {
      h += '<option value="' + k + '"' + (sel === k ? ' selected' : '') + '>' + LIB_PRIORITE[k] + '</option>';
    });
    return h;
  }

  function buildUserCombobox(selectedId) {
    var wrap = document.createElement('div');
    wrap.className = 'user-combo';
    wrap.style.cssText = 'position:relative;min-width:200px;';

    var display = document.createElement('button');
    display.type = 'button';
    display.className = 'user-combo-btn';
    display.style.cssText = 'width:100%;text-align:left;padding:8px 10px;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:8px;background:#fff;cursor:pointer;font-size:13px;';

    function labelFor(id) {
      if (!id) return '— Tout le monde —';
      if (String(id) === String(CURRENT_ID)) return 'Moi';
      var r = getRecentUsers().find(function (u) { return String(u.id) === String(id); });
      if (r) return r.label;
      var u = USERS.find(function (x) { return String(x.id) === String(id); });
      return u ? u.label : ('#' + id);
    }
    display.textContent = labelFor(selectedId);

    var panel = document.createElement('div');
    panel.className = 'user-combo-panel';
    panel.hidden = true;
    panel.style.cssText = 'position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:40;background:#fff;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);padding:8px;max-height:260px;overflow:auto;';

    var search = document.createElement('input');
    search.type = 'search';
    search.placeholder = 'Rechercher…';
    search.style.cssText = 'width:100%;box-sizing:border-box;margin-bottom:6px;padding:7px 9px;border:1px solid var(--gris-bordure,#cbd5e1);border-radius:8px;font-size:13px;';

    var list = document.createElement('div');
    var hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.className = 'val-user';
    hidden.value = selectedId || '';

    function pick(id, label) {
      hidden.value = id || '';
      display.textContent = label || '— Tout le monde —';
      if (id) pushRecentUser(id, label);
      panel.hidden = true;
    }

    function renderList(q) {
      q = (q || '').trim().toLowerCase();
      list.innerHTML = '';
      function addItem(id, label, meta) {
        var b = document.createElement('button');
        b.type = 'button';
        b.style.cssText = 'display:block;width:100%;text-align:left;padding:7px 9px;border:none;background:transparent;border-radius:6px;cursor:pointer;font-size:13px;';
        b.textContent = label + (meta ? ' · ' + meta : '');
        if (String(hidden.value) === String(id || '')) b.style.background = 'var(--bleu-clair,#eff6ff)';
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          pick(id, label);
        });
        list.appendChild(b);
      }
      addItem('', '— Tout le monde —');
      if (CURRENT_ID) addItem(CURRENT_ID, 'Moi');
      getRecentUsers().forEach(function (u) {
        if (String(u.id) === String(CURRENT_ID)) return;
        if (q && String(u.label).toLowerCase().indexOf(q) < 0) return;
        addItem(u.id, u.label, 'récent');
      });
      if (q.length >= 1) {
        USERS.filter(function (u) {
          if (String(u.id) === String(CURRENT_ID)) return false;
          return u.label.toLowerCase().indexOf(q) >= 0 || String(u.id).indexOf(q) >= 0;
        }).slice(0, 20).forEach(function (u) {
          if (getRecentUsers().some(function (r) { return String(r.id) === String(u.id); })) return;
          addItem(u.id, u.label);
        });
      }
    }

    display.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      document.querySelectorAll('.user-combo-panel').forEach(function (p) { p.hidden = true; });
      panel.hidden = !open;
      if (!panel.hidden) {
        renderList(search.value);
        setTimeout(function () { search.focus(); }, 10);
      }
    });
    search.addEventListener('input', function () { renderList(search.value); });
    search.addEventListener('click', function (e) { e.stopPropagation(); });

    panel.appendChild(search);
    panel.appendChild(list);
    wrap.appendChild(display);
    wrap.appendChild(hidden);
    wrap.appendChild(panel);
    return wrap;
  }

  function addFiltreBloc(values) {
    values = values || {};
    if (!blocs) return;
    blocIndex += 1;
    var n = blocIndex;
    var box = document.createElement('div');
    box.className = 'bloc-filtre';
    box.style.cssText = 'border:1px solid var(--gris-bordure,#e2e8f0);border-radius:10px;padding:8px 10px;margin-bottom:8px;background:#fff;';
    box.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">' +
      '<strong style="font-size:12.5px;color:var(--bleu-fonce,#1e3a5f);"><i class="bi bi-funnel"></i> Filtre ' + n + '</strong>' +
      '<button type="button" class="btn btn-gris btn-petit btn-rm-bloc" title="Retirer ce filtre">×</button>' +
      '</div>' +
      '<div class="filtres-selects" style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;">' +
      '<div style="flex:1 1 180px;min-width:160px;"><label>Recherche</label>' +
      '<div style="position:relative;">' +
      '<i class="bi bi-search" style="position:absolute;left:8px;top:50%;transform:translateY(-50%);color:var(--gris,#94a3b8);font-size:12px;pointer-events:none;"></i>' +
      '<input type="search" class="f-q" placeholder="Titre ou description…" value="' + String(values.q || '').replace(/"/g, '&quot;') + '" ' +
      'style="width:100%;box-sizing:border-box;padding:6px 8px 6px 28px;border:1px solid var(--gris-bordure,#e2e8f0);border-radius:8px;font-size:13px;">' +
      '</div></div>' +
      '<div><label>Statut</label><select class="f-statut">' + optsStatut(values.statut || '') + '</select></div>' +
      '<div><label>Priorité</label><select class="f-priorite">' + optsPriorite(values.priorite || '') + '</select></div>' +
      '<div class="user-wrap-c"><label>Créé par</label><div class="f-createur-slot"></div></div>' +
      '<div class="user-wrap-a"><label>Assigné à</label><div class="f-assigne-slot"></div></div>' +
      '</div>';
    blocs.appendChild(box);
    box.querySelector('.f-createur-slot').appendChild(buildUserCombobox(values.id_createur || ''));
    box.querySelector('.f-assigne-slot').appendChild(buildUserCombobox(values.id_assigne || ''));
    box.querySelector('.btn-rm-bloc').addEventListener('click', function () {
      if (blocs.querySelectorAll('.bloc-filtre').length <= 1) {
        box.querySelector('.f-statut').value = '';
        box.querySelector('.f-priorite').value = '';
        var fq = box.querySelector('.f-q'); if (fq) fq.value = '';
        var slotC = box.querySelector('.f-createur-slot');
        var slotA = box.querySelector('.f-assigne-slot');
        if (slotC) { slotC.innerHTML = ''; slotC.appendChild(buildUserCombobox('')); }
        if (slotA) { slotA.innerHTML = ''; slotA.appendChild(buildUserCombobox('')); }
        return;
      }
      box.remove();
    });
  }

  if (blocs) {
    function splitVal(v) {
      return String(v || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
    }
    var ss = splitVal(initial.statut);
    var pp = splitVal(initial.priorite);
    var cc = splitVal(initial.id_createur);
    var aa = splitVal(initial.id_assigne);
    // Recherche : un terme par filtre (séparés par | pour ne pas casser les espaces)
    var qq = String(initial.q || '').split('|').map(function (s) { return s.trim(); });
    var n = Math.max(ss.length, pp.length, cc.length, aa.length, qq.filter(Boolean).length, 0);
    if (n === 0) {
      addFiltreBloc({});
    } else {
      for (var i = 0; i < n; i++) {
        addFiltreBloc({
          statut: ss[i] || '',
          priorite: pp[i] || '',
          id_createur: cc[i] || '',
          id_assigne: aa[i] || '',
          q: qq[i] || ''
        });
      }
    }
  }

  var btnAdd = document.getElementById('btn-ajouter-filtre');
  if (btnAdd) btnAdd.addEventListener('click', function () { addFiltreBloc({}); });

  function collectFromBlocs() {
    var map = { statut: [], priorite: [], id_createur: [], id_assigne: [], q: [] };
    if (!blocs) return { statut: '', priorite: '', id_createur: '', id_assigne: '', q: '' };
    blocs.querySelectorAll('.bloc-filtre').forEach(function (box) {
      var s = box.querySelector('.f-statut').value;
      var p = box.querySelector('.f-priorite').value;
      var qEl = box.querySelector('.f-q');
      var qv = qEl ? String(qEl.value || '').trim() : '';
      var cEl = box.querySelector('.user-wrap-c .val-user');
      var aEl = box.querySelector('.user-wrap-a .val-user');
      var cv = cEl ? cEl.value : '';
      var av = aEl ? aEl.value : '';
      if (s) map.statut.push(s);
      if (p) map.priorite.push(p);
      if (cv) map.id_createur.push(cv);
      if (av) map.id_assigne.push(av);
      // Toujours pousser un slot q (même vide) pour aligner les filtres multi
      map.q.push(qv);
    });
    // Joindre les recherches non vides avec | (un terme par filtre)
    var qs = map.q.filter(Boolean);
    return {
      statut: map.statut.join(','),
      priorite: map.priorite.join(','),
      id_createur: map.id_createur.join(','),
      id_assigne: map.id_assigne.join(','),
      q: qs.join('|')
    };
  }

  if (form) {
    form.addEventListener('submit', function () {
      var m = collectFromBlocs();
      var par = (document.getElementById('par_page') || {}).value || '';
      m.par_page = par;
      setActifs(m);
      var hs = document.getElementById('hid-statut');
      var hp = document.getElementById('hid-priorite');
      var hc = document.getElementById('hid-id_createur');
      var ha = document.getElementById('hid-id_assigne');
      var hq = document.getElementById('hid-q');
      if (hs) hs.value = m.statut;
      if (hp) hp.value = m.priorite;
      if (hc) hc.value = m.id_createur;
      if (ha) ha.value = m.id_assigne;
      if (hq) hq.value = m.q || '';
    });
  }

  var btnReset = document.getElementById('btn-reset-filtres');
  if (btnReset) {
    btnReset.addEventListener('click', function () {
      setActifs({});
    });
  }

  document.querySelectorAll('.retirer-filtre').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      var cle = a.getAttribute('data-cle');
      var m = getActifs();
      m[cle] = '';
      setActifs(m);
      var q = new URLSearchParams();
      ['statut', 'priorite', 'id_createur', 'id_assigne', 'q', 'par_page'].forEach(function (k) {
        if (m[k]) q.set(k, m[k]);
      });
      window.location.href = '/tickets' + (q.toString() ? ('?' + q.toString()) : '');
    });
  });

  document.addEventListener('click', function () {
    document.querySelectorAll('.user-combo-panel').forEach(function (p) { p.hidden = true; });
  });
})();
</script>







<% if (typeof total !== 'undefined') { %>
<p style="font-size:13px;color:var(--gris);margin:0 0 10px;"><%= total %> ticket(s)</p>
<% } %>
<% if (!tickets || !tickets.length) { %>
    <div class="carte vide">Aucun ticket ne correspond à ces filtres.</div>
<% } else { %>
    <div class="carte">
        <table class="tableau">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Statut</th>
                    <th>Priorité</th>
                    <th>Lié à</th>
                    <th>Créé par</th>
                    <th>Assigné</th>
                    <th>Ouvert le</th>
                </tr>
            </thead>
            <tbody>
            <% tickets.forEach(function(t) { %>
                <tr>
                    <td>#<%= t.id %></td>
                    <td><a href="/tickets/<%= t.id %>"><%= t.titre %></a></td>
                    <td><span class="badge-statut badge-statut-<%= t.statut %>"><%= LIBELLES_STATUT[t.statut] || t.statut %></span></td>
                    <td><span class="badge-priorite badge-priorite-<%= t.priorite %>"><%= LIBELLES_PRIORITE[t.priorite] || t.priorite %></span></td>
                    <td style="font-size:13px; color:var(--gris);">
                        <% if (t.Outil) { %><i class="bi bi-tools"></i> <%= t.Outil.nom %>
                        <% } else if (t.SousActivite) { %><i class="bi bi-folder2"></i> <%= t.SousActivite.nom %>
                        <% } else if (t.Activite) { %><i class="bi bi-folder"></i> <%= t.Activite.nom %>
                        <% } else { %>—<% } %>
                    </td>
                    <td style="font-size:13px;"><%= t.Createur ? (t.Createur.prenom + ' ' + t.Createur.nom) : '—' %></td>
                    <td style="font-size:13px;"><%= t.Assigne ? (t.Assigne.prenom + ' ' + t.Assigne.nom) : '—' %></td>
                    <td style="font-size:13px; color:var(--gris); white-space:nowrap;"><%= t.createdAt ? new Date(t.createdAt).toLocaleString('fr-FR') : '—' %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

 <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
 <div style="display:flex; gap:8px; margin-top:14px; align-items:center; flex-wrap:wrap;">
 <% if (page > 1) { %>
 <a href="/tickets?page=<%= page - 1 %>&par_page=<%= par_page %>&statut=<%= statut %>&priorite=<%= priorite %>&id_createur=<%= id_createur %>&id_assigne=<%= id_assigne %>" class="btn btn-gris btn-petit"><i class="bi bi-arrow-left"></i> Précédent</a>
 <% } %>
 <span style="color:var(--gris); font-size:13px;">Page <%= page %> / <%= totalPages %></span>
 <% if (page < totalPages) { %>
 <a href="/tickets?page=<%= page + 1 %>&par_page=<%= par_page %>&statut=<%= statut %>&priorite=<%= priorite %>&id_createur=<%= id_createur %>&id_assigne=<%= id_assigne %>" class="btn btn-gris btn-petit">Suivant <i class="bi bi-arrow-right"></i> </a>
 <% } %>
 </div>
 <% } %>

<%- include('../partials/footer') %>
