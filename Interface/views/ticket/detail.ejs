<%- include('../partials/header') %>
<% var sla = ticket.sla_statut || 'sans_sla'; %>
<div class="entete-page">
 <h1><i class="bi bi-ticket-detailed"></i> #<%= ticket.id %> — <%= ticket.titre %></h1>
 <% if (peut('tickets', 'delete')) { %>
 <form action="/tickets/<%= ticket.id %>/supprimer" method="POST" class="form-inline"
 onsubmit="return confirm('Supprimer ce ticket et tout son historique de messages ?');">
 <button type="submit" class="btn btn-danger">Supprimer</button>
 </form>
 <% } %>
</div>

<div class="carte" style="margin-bottom:14px; padding:12px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center;">
        <span>
            <strong>SLA :</strong>
            <% if (sla === 'depasse') { %><span class="badge-sla depasse"><i class="bi bi-exclamation-triangle"></i> Dépassé</span>
            <% } else if (sla === 'bientot') { %><span class="badge-sla bientot"><i class="bi bi-hourglass-split"></i> Bientôt</span>
            <% } else if (sla === 'ok') { %><span class="badge-sla ok"><i class="bi bi-check-circle"></i> Dans les délais</span>
            <% } else { %>—<% } %>
            <% if (ticket.sla_echeance) { %>
                <span style="color:var(--gris); font-size:13px;"> · échéance <%= new Date(ticket.sla_echeance).toLocaleString('fr-FR') %></span>
            <% } %>
        </span>
        <% if (ticket.escalade_le) { %>
            <span class="badge-sla depasse"><i class="bi bi-arrow-up-circle"></i> Escaladé le <%= new Date(ticket.escalade_le).toLocaleString('fr-FR') %></span>
        <% } %>
        <% if (peut('tickets', 'update') && ticket.statut !== 'resolu' && ticket.statut !== 'ferme') { %>
            <form action="/tickets/<%= ticket.id %>/escalader" method="POST" style="margin:0;" onsubmit="return confirm('Escalader ce ticket vers un administrateur ?');">
                <button type="submit" class="btn btn-gris btn-petit"><i class="bi bi-arrow-up-circle"></i> Escalader vers un admin</button>
            </form>
        <% } %>
    </div>
</div>


<div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; align-items:flex-start;">
 <div>
 <div class="carte">
 <p style="white-space:pre-wrap; margin:0 0 12px; font-size:14px;"><%= ticket.description %></p>

 <% if (ticket.images && ticket.images.length) { %>
 <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
 <% ticket.images.forEach(function(img) { %>
 <a href="<%= img.chemin %>" target="_blank" rel="noopener">
 <img src="<%= img.chemin %>" alt="Image jointe" style="width:90px; height:90px; object-fit:cover; border-radius:var(--rayon); border:1px solid var(--gris-bordure);">
 </a>
 <% }) %>
 </div>
 <% } %>

 <p style="color:var(--gris); font-size:13px; margin:0;">
 Ouvert par <strong><%= ticket.Createur ? ticket.Createur.prenom + ' ' + ticket.Createur.nom : '—' %></strong>
 le <%= new Date(ticket.createdAt).toLocaleString('fr-FR') %>
 <% if (ticket.Outil) { %> · Outil : <strong><i class="bi bi-tools"></i> <%= ticket.Outil.nom %></strong><% } %>
 <% if (ticket.SousActivite) { %> · Sous-activité : <strong><i class="bi bi-folder2-open"></i> <%= ticket.SousActivite.nom %></strong><% } %>
 <% if (ticket.Activite) { %> · Activité : <strong><i class="bi bi-folder"></i> <%= ticket.Activite.nom %></strong><% } %>
 </p>
 </div>

 <h2 style="font-size:16px; color:var(--bleu-fonce); margin:20px 0 10px;"><i class="bi bi-chat-dots"></i> Discussion</h2>

 <% if (!ticket.messages.length) { %>
 <div class="carte vide">Aucun message pour l'instant.</div>
 <% } else { %>
 <div style="display:flex; flex-direction:column; gap:10px;">
 <% ticket.messages.forEach(function(m) {
   var estAuteur = currentUser && m.id_user === currentUser.id;
   var ageMs = Date.now() - new Date(m.createdAt).getTime();
   var peutEditer = estAuteur && ageMs <= 5 * 60 * 1000;
 %>
 <div class="carte" style="padding:12px 16px;" data-message-id="<%= m.id %>">
 <p style="margin:0 0 6px; font-size:13px; color:var(--bleu-fonce); font-weight:600;">
 <%= m.Auteur ? m.Auteur.prenom + ' ' + m.Auteur.nom : 'Utilisateur supprimé' %>
 <span style="font-weight:400; color:var(--gris);"> · <%= new Date(m.createdAt).toLocaleString('fr-FR') %></span>
 <% if (peutEditer) { %>
 <button type="button" class="btn btn-gris btn-petit btn-edit-msg" style="margin-left:8px;" data-id="<%= m.id %>">Modifier</button>
 <% } %>
 </p>
 <p class="msg-contenu" style="margin:0; font-size:14px; white-space:pre-wrap;"><%= m.contenu %></p>
 <form class="form-edit-msg" action="/tickets/<%= ticket.id %>/messages/<%= m.id %>/modifier" method="POST" hidden style="margin-top:8px;">
  <textarea name="contenu" rows="3" required><%= m.contenu %></textarea>
  <div class="actions-form">
   <button type="submit" class="btn btn-primaire btn-petit">Enregistrer</button>
   <button type="button" class="btn btn-gris btn-petit btn-cancel-edit">Annuler</button>
  </div>
 </form>
 </div>
 <% }) %>
<script>
document.querySelectorAll('.btn-edit-msg').forEach(function(btn){
  btn.addEventListener('click', function(){
    var card = btn.closest('.carte');
    card.querySelector('.msg-contenu').hidden = true;
    card.querySelector('.form-edit-msg').hidden = false;
    btn.hidden = true;
  });
});
document.querySelectorAll('.btn-cancel-edit').forEach(function(btn){
  btn.addEventListener('click', function(){
    var card = btn.closest('.carte');
    card.querySelector('.msg-contenu').hidden = false;
    card.querySelector('.form-edit-msg').hidden = true;
    var editBtn = card.querySelector('.btn-edit-msg');
    if (editBtn) editBtn.hidden = false;
  });
});
</script>
 </div>
 <% } %>

 <div class="carte" style="margin-top:14px;">
 <form action="/tickets/<%= ticket.id %>/messages" method="POST">
 <label for="contenu">Ajouter un message</label>
 <textarea id="contenu" name="contenu" rows="3" required placeholder="Écrire une réponse..."></textarea>
 <div class="actions-form">
 <button type="submit" class="btn btn-primaire">Envoyer</button>
 </div>
 </form>
 </div>
 </div>

 <div>
 <div class="carte">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 12px;">Statut du ticket</h2>
 <form action="/tickets/<%= ticket.id %>/modifier" method="POST">
 <label for="statut">Statut</label>
 <select id="statut" name="statut" onchange="this.form.submit()" <%= !(peut('tickets','update') || (currentUser && (ticket.id_createur === currentUser.id || (ticket.Assigne && ticket.Assigne.id === currentUser.id)))) ? 'disabled' : '' %>>
 <% Object.keys(LIBELLES_STATUT).forEach(function(s) { %>
 <option value="<%= s %>" <%= ticket.statut === s ? 'selected' : '' %>><%= LIBELLES_STATUT[s] %></option>
 <% }) %>
 </select>

 <label for="priorite">Priorité</label>
 <select id="priorite" name="priorite" onchange="this.form.submit()" <%= !(peut('tickets','update') || (currentUser && (ticket.id_createur === currentUser.id || (ticket.Assigne && ticket.Assigne.id === currentUser.id)))) ? 'disabled' : '' %>>
 <% Object.keys(LIBELLES_PRIORITE).forEach(function(p) { %>
 <option value="<%= p %>" <%= ticket.priorite === p ? 'selected' : '' %>><%= LIBELLES_PRIORITE[p] %></option>
 <% }) %>
 </select>

 <% var selUsers = Array.isArray(ticket.assignees_users) ? ticket.assignees_users.map(Number) : (ticket.Assigne ? [ticket.Assigne.id] : []); %>
 <% var selRoles = Array.isArray(ticket.assignees_roles) ? ticket.assignees_roles.map(Number) : []; %>
 <label for="assignees_users">Assigné aux utilisateurs</label>
 <select id="assignees_users" name="assignees_users" multiple size="5" style="min-height:100px;">
 <% (utilisateurs || []).forEach(function(u) { %>
 <option value="<%= u.id %>" <%= selUsers.indexOf(u.id) >= 0 ? 'selected' : '' %>><%= u.prenom %> <%= u.nom %></option>
 <% }) %>
 </select>
 <p style="font-size:12px;color:var(--gris);">Maintenir Ctrl (ou Cmd) pour sélectionner plusieurs personnes.</p>
 <% if (typeof roles !== 'undefined' && roles && roles.length) { %>
 <label for="assignees_roles">Assigné aux rôles</label>
 <select id="assignees_roles" name="assignees_roles" multiple size="4" style="min-height:80px;">
 <% roles.forEach(function(r) { %>
 <option value="<%= r.id %>" <%= selRoles.indexOf(r.id) >= 0 ? 'selected' : '' %>><%= r.nom %></option>
 <% }) %>
 </select>
 <% } %>
 <div class="actions-form">
 <button type="submit" class="btn btn-primaire btn-petit">Enregistrer l'assignation</button>
 </div>
 </form>
 </div>
 </div>
</div>

<%- include('../partials/footer') %>
