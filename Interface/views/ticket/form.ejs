<%- include('../partials/header') %>
<div class="entete-page"><h1><i class="bi bi-ticket-detailed"></i> Nouveau ticket</h1></div>

<div class="carte" style="max-width:640px;">
 <% if (erreur) { %>
 <div class="message-erreur"><%= erreur %></div>
 <% } %>

 <form action="/tickets" method="POST" enctype="multipart/form-data">
 <label for="titre">Titre</label>
 <input type="text" id="titre" name="titre" required placeholder="Résumé court du problème" autofocus>

 <label for="description">Description</label>
 <textarea id="description" name="description" rows="5" required placeholder="Détaillez le problème ou la demande..."></textarea>

 <label for="priorite">Priorité</label>
 <select id="priorite" name="priorite">
 <option value="basse">Basse</option>
 <option value="normale" selected>Normale</option>
 <option value="haute">Haute</option>
 <option value="urgente">Urgente</option>
 </select>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:18px 0;">
 <p style="color:var(--gris); font-size:13px; margin:0 0 10px;">
 Concerne (optionnel) — choisissez une activité pour affiner jusqu'à l'outil précis.
 </p>

 <!-- La sélection activité/sous-activité recharge la page (comme pour
 le reste de l'appli) pour ne proposer que des options cohérentes,
 déjà scopées au périmètre de l'utilisateur côté Server. -->
 <label for="id_activite">Activité</label>
 <select id="id_activite" name="id_activite" onchange="rechargerCascade()">
 <option value="">— Aucune —</option>
 <% activites.forEach(function(a) { %>
 <option value="<%= a.id %>" <%= String(id_activite) === String(a.id) ? 'selected' : '' %>><%= a.nom %></option>
 <% }) %>
 </select>

 <% if (id_activite) { %>
 <label for="id_sous_activite">Sous-activité</label>
 <select id="id_sous_activite" name="id_sous_activite" onchange="rechargerCascade()">
 <option value="">— Aucune —</option>
 <% sousActivites.forEach(function(sa) { %>
 <option value="<%= sa.id %>" <%= String(id_sous_activite) === String(sa.id) ? 'selected' : '' %>><%= sa.nom %></option>
 <% }) %>
 </select>

 <label for="id_outil">Outil concerné</label>
 <select id="id_outil" name="id_outil">
 <option value="">— Aucun outil précis —</option>
 <% outils.forEach(function(o) { %>
 <option value="<%= o.id %>" <%= String(id_outil) === String(o.id) ? 'selected' : '' %>><i class="bi bi-tools"></i> <%= o.nom %></option>
 <% }) %>
 </select>
 <% if (!outils.length) { %>
 <p style="color:var(--gris); font-size:12px; margin-top:-6px;">Aucun outil actif trouvé sur ce périmètre.</p>
 <% } %>
 <% } %>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:18px 0;">

 <label for="images">Images (optionnel, jusqu'à 6)</label>
 <input type="file" id="images" name="images" accept="image/*" multiple>
 <p style="color:var(--gris); font-size:12px; margin-top:-6px;">Photos du problème, capture d'écran, etc.</p>

 <div class="actions-form">
 <button type="submit" class="btn btn-primaire">Ouvrir le ticket</button>
 </div>
 </form>
</div>

<script>
 // On recharge simplement la page avec les valeurs actuellement
 // sélectionnées : le serveur renvoie alors les bonnes listes de
 // sous-activités/outils pour la nouvelle activité/sous-activité choisie.
 function rechargerCascade() {
 var idActivite = document.getElementById('id_activite').value;
 var url = '/tickets/nouveau?id_activite=' + encodeURIComponent(idActivite);
 var elSousActivite = document.getElementById('id_sous_activite');
 if (idActivite && elSousActivite && document.activeElement && document.activeElement.id === 'id_sous_activite') {
 url += '&id_sous_activite=' + encodeURIComponent(elSousActivite.value);
 }
 window.location.href = url;
 }
</script>

<%- include('../partials/footer') %>
