<%- include('partials/header') %>
<% if (typeof query !== 'undefined' && query.succes) { %><div class="message-succes"><%= query.succes %></div><% } %>
<% if (typeof query !== 'undefined' && query.erreur) { %><div class="message-erreur"><%= query.erreur %></div><% } %>

<div class="entete-page"><h1>Réglages généraux</h1></div>

<% if (erreur) { %>
 <div class="message-erreur"><%= erreur %></div>
<% } %>
<% if (succes) { %>
 <div class="message-succes">Réglages enregistrés.</div>
<% } %>

<div class="reglages-grille">
<div class="carte" style="max-width:none;">
 <form action="/parametres" method="POST" id="form-reglages">
 <label for="nom_entreprise">Nom de l'entreprise</label>
 <input type="text" id="nom_entreprise" name="nom_entreprise" value="<%= parametre.nom_entreprise || '' %>"
 placeholder="Laisser vide pour afficher « Gestionnaire Outils »">
 <p style="color:var(--gris); font-size:13px; margin-top:-6px;">
 S'affiche dans l'en-tête et la page de connexion.
 </p>

 <label for="mot_de_passe_defaut">Mot de passe par défaut</label>
 <input type="password" id="mot_de_passe_defaut" name="mot_de_passe_defaut" value="<%= parametre.mot_de_passe_defaut %>" minlength="6" required>
 <p style="color:var(--gris); font-size:13px; margin-top:-6px;">
 Attribué aux nouveaux utilisateurs et lors d'une réinitialisation. L'utilisateur devra le changer à la première connexion.
 </p>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-lock"></i> Politique de mot de passe</h2>
 <label for="mdp_longueur_min">Longueur minimale</label>
 <input type="number" id="mdp_longueur_min" name="mdp_longueur_min" min="4" max="32"
 value="<%= parametre.mdp_longueur_min %>" style="max-width:120px;">
 <div class="champ-case">
 <input type="checkbox" id="mdp_complexite" name="mdp_complexite" <%= parametre.mdp_complexite ? 'checked' : '' %>>
 <label for="mdp_complexite">Exiger majuscule + minuscule + chiffre</label>
 </div>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-shield-check"></i> Anti-brute-force</h2>
 <label for="max_tentatives_connexion">Tentatives max avant blocage</label>
 <input type="number" id="max_tentatives_connexion" name="max_tentatives_connexion" min="3" max="20"
 value="<%= parametre.max_tentatives_connexion %>" style="max-width:120px;">
 <label for="duree_blocage_minutes">Durée du blocage (minutes)</label>
 <input type="number" id="duree_blocage_minutes" name="duree_blocage_minutes" min="1" max="1440"
 value="<%= parametre.duree_blocage_minutes %>" style="max-width:120px;">

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-clock-history"></i> Session</h2>
 <label for="session_duree_heures">Durée de session (heures)</label>
 <input type="number" id="session_duree_heures" name="session_duree_heures" min="1" max="168"
 value="<%= parametre.session_duree_heures || 8 %>" style="max-width:120px;">
 <p style="font-size:12px;color:var(--gris);">Durée pendant laquelle un utilisateur reste connecté sans se ré-authentifier (1 à 168 h). Défaut : 8 h. La session se prolonge tant qu’il y a de l’activité.</p>

 <label for="mdp_expiration_jours">Expiration des mots de passe (jours)</label>
 <input type="number" id="mdp_expiration_jours" name="mdp_expiration_jours" min="0" max="730"
 value="<%= parametre.mdp_expiration_jours || 0 %>" style="max-width:120px;">
 <p style="font-size:12px;color:var(--gris);">0 = jamais. Ex. 90 = obligation de renouveler tous les 90 jours.</p>
 <label for="mdp_historique_count">Historique des mots de passe (nombre)</label>
 <input type="number" id="mdp_historique_count" name="mdp_historique_count" min="0" max="24"
 value="<%= parametre.mdp_historique_count || 0 %>" style="max-width:120px;">
 <p style="font-size:12px;color:var(--gris);">Empêche de réutiliser les N derniers mots de passe (0 = désactivé).</p>
 <p style="font-size:12px;color:var(--gris);">Durée pendant laquelle un utilisateur reste connecté sans se ré-authentifier (1 à 168 h). Défaut : 8 h. La session se prolonge tant qu’il y a de l’activité.</p>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-hdd-network"></i> Surveillance réseau</h2>
 <div class="champ-case">
 <input type="checkbox" id="surveillance_active" name="surveillance_active" <%= parametre.surveillance_active ? 'checked' : '' %>>
 <label for="surveillance_active">Activer la surveillance automatique</label>
 </div>
 <label for="surveillance_intervalle_minutes">Intervalle (minutes)</label>
 <input type="number" id="surveillance_intervalle_minutes" name="surveillance_intervalle_minutes" min="1" max="120"
 value="<%= parametre.surveillance_intervalle_minutes %>" style="max-width:120px;">

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-shield-lock"></i> 2FA & credentials</h2>
 <div class="champ-case">
 <input type="checkbox" id="totp_disponible" name="totp_disponible" <%= parametre.totp_disponible !== false ? 'checked' : '' %>>
 <label for="totp_disponible">Autoriser la 2FA (application)</label>
 </div>
 <div class="champ-case">
 <input type="checkbox" id="totp_obligatoire" name="totp_obligatoire" <%= parametre.totp_obligatoire ? 'checked' : '' %>>
 <label for="totp_obligatoire">Rendre la 2FA obligatoire</label>
 </div>
 <div class="champ-case">
 <input type="checkbox" id="credentials_actifs" name="credentials_actifs" <%= parametre.credentials_actifs ? 'checked' : '' %>>
 <label for="credentials_actifs">Activer les credentials sur les outils</label>
 </div>
 <label for="chiffrement_algo">Algorithme de chiffrement</label>
 <select id="chiffrement_algo" name="chiffrement_algo">
  <option value="aes-256-gcm" <%= (parametre.chiffrement_algo || 'aes-256-gcm') === 'aes-256-gcm' ? 'selected' : '' %>>AES-256-GCM (recommandé)</option>
  <option value="aes-256-cbc" <%= parametre.chiffrement_algo === 'aes-256-cbc' ? 'selected' : '' %>>AES-256-CBC</option>
  <option value="chacha20-poly1305" <%= parametre.chiffrement_algo === 'chacha20-poly1305' ? 'selected' : '' %>>ChaCha20-Poly1305</option>
 </select>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-globe2"></i> Accès public</h2>
 <div class="champ-case">
 <input type="checkbox" id="stats_publiques" name="stats_publiques" <%= parametre.stats_publiques ? 'checked' : '' %>>
 <label for="stats_publiques">Tableau de bord public (sans connexion)</label>
 </div>
 <p style="font-size:12px;color:var(--gris);margin-top:-4px;">
 URL : <a href="/public/statistiques" target="_blank"><code>/public/statistiques</code></a>
 </p>

 <hr style="border:none; border-top:1px solid var(--gris-bordure); margin:22px 0;">
 <h2 style="font-size:15px; color:var(--bleu-fonce); margin:0 0 4px;"><i class="bi bi-arrow-clockwise"></i> Rafraîchissement automatique</h2>
 <div class="champ-case">
 <input type="checkbox" id="rafraichissement_auto" name="rafraichissement_auto" <%= parametre.rafraichissement_auto ? 'checked' : '' %>>
 <label for="rafraichissement_auto">Activer le rechargement automatique des pages</label>
 </div>
 <label for="rafraichissement_intervalle_min">Intervalle (minutes)</label>
 <input type="number" id="rafraichissement_intervalle_min" name="rafraichissement_intervalle_min" min="1" max="120"
  value="<%= parametre.rafraichissement_intervalle_min || 5 %>" style="max-width:120px;">
 <p style="font-size:12px;color:var(--gris);">
  Recharge la page courante à intervalle régulier (utile pour le tableau de bord, tickets, surveillance).
  Désactivez si vous saisissez de longs formulaires.
 </p>

 <div class="actions-form">
 <button type="submit" class="btn btn-primaire">Enregistrer</button>
 </div>
 </form>
</div>

<div class="reglages-col-droite">
  <div class="carte">
    <h2 style="font-size:15px;color:var(--bleu-fonce);margin:0 0 8px;"><i class="bi bi-device-hdd"></i> Sauvegarde & restauration</h2>
    <p style="color:var(--gris);font-size:13px;margin:0 0 12px;">
      Exportez toutes les données GLO en JSON, ou restaurez une sauvegarde précédente.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
      <a href="/parametres/sauvegarde/export" class="btn btn-gris"><i class="bi bi-download"></i> Télécharger</a>
    </div>
    <form action="/parametres/sauvegarde/restaurer" method="POST" enctype="multipart/form-data"
      onsubmit="return confirm('Restaurer cette sauvegarde ? Les données actuelles peuvent être écrasées.');">
      <label for="fichier_sauvegarde">Fichier .json</label>
      <input type="file" id="fichier_sauvegarde" name="fichier" accept=".json,application/json" required>
      <button type="submit" class="btn btn-primaire" style="margin-top:8px;"><i class="bi bi-upload"></i> Restaurer</button>
    </form>
  </div>

  <div class="carte">
    <h2 style="font-size:15px;color:var(--bleu-fonce);margin:0 0 8px;"><i class="bi bi-calendar-check"></i> Planification</h2>
    <p style="color:var(--gris);font-size:12px;margin:0 0 12px;">
      Enregistré avec le bouton <strong>Enregistrer</strong> à gauche.
    </p>
    <div class="champ-case">
      <input type="checkbox" form="form-reglages" id="sauvegarde_planifiee" name="sauvegarde_planifiee" <%= parametre.sauvegarde_planifiee ? 'checked' : '' %>>
      <label for="sauvegarde_planifiee">Sauvegarde automatique</label>
    </div>
    <label for="sauvegarde_intervalle_heures">Intervalle (heures)</label>
    <input type="number" form="form-reglages" id="sauvegarde_intervalle_heures" name="sauvegarde_intervalle_heures" min="1" max="168"
      value="<%= parametre.sauvegarde_intervalle_heures || 24 %>" style="max-width:120px;">
    <label for="sauvegarde_dossier">Dossier de sauvegarde</label>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
      <input type="text" form="form-reglages" id="sauvegarde_dossier" name="sauvegarde_dossier"
        value="<%= parametre.sauvegarde_dossier || '' %>"
        placeholder="ex. C:\GLO\backups ou /var/backups/glo"
        style="flex:1;min-width:180px;box-sizing:border-box;" list="suggestions-dossiers">
      <datalist id="suggestions-dossiers">
        <option value="C:\GLO\backups"></option>
        <option value="D:\Backups\GLO"></option>
        <option value="/var/backups/glo"></option>
        <option value="/opt/glo/sauvegardes"></option>
      </datalist>
      <button type="button" class="btn btn-gris btn-petit" id="btn-parcourir-dossier" title="Suggérer un chemin depuis un dossier local (si le navigateur le permet)">
        <i class="bi bi-folder2-open"></i> Parcourir…
      </button>
      <input type="file" id="input-parcourir-dossier" webkitdirectory directory multiple style="display:none;">
    </div>
    <p style="font-size:12px;color:var(--gris);margin:6px 0 0;">
      Saisissez un chemin <strong>absolu sur la machine qui héberge le Server GLO</strong>
      (pas seulement le poste de l’administrateur). Vide = <code>Server/uploads/sauvegardes-auto/</code>.
      Le bouton Parcourir peut préremplir un chemin si le navigateur expose le dossier (même machine).
    </p>
    <p style="font-size:12px;color:#9a3412;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:8px 10px;margin:8px 0 0;">
      <i class="bi bi-exclamation-triangle"></i>
      <strong>GLO doit avoir un accès en écriture</strong> sur ce dossier
      (compte Windows/Linux du processus Node.js du Server). Sans ce droit, les sauvegardes automatiques échoueront.
    </p>

    <div class="champ-case" style="margin-top:12px;">
      <input type="checkbox" form="form-reglages" id="journal_nettoyage_actif" name="journal_nettoyage_actif" <%= parametre.journal_nettoyage_actif ? 'checked' : '' %>>
      <label for="journal_nettoyage_actif">Nettoyage auto du journal</label>
    </div>
    <label for="journal_retention_jours">Rétention (jours)</label>
    <input type="number" form="form-reglages" id="journal_retention_jours" name="journal_retention_jours" min="7" max="3650"
      value="<%= parametre.journal_retention_jours || 90 %>" style="max-width:120px;">

    <hr style="border:none;border-top:1px solid var(--gris-bordure);margin:14px 0;">
    <div class="champ-case">
      <input type="checkbox" form="form-reglages" id="rapport_planifie" name="rapport_planifie" <%= parametre.rapport_planifie ? 'checked' : '' %>>
      <label for="rapport_planifie">Rapports tickets planifiés (e-mail)</label>
    </div>
    <label for="rapport_intervalle_heures">Intervalle rapport (heures)</label>
    <input type="number" form="form-reglages" id="rapport_intervalle_heures" name="rapport_intervalle_heures" min="1" max="720"
      value="<%= parametre.rapport_intervalle_heures || 168 %>" style="max-width:120px;">
    <label for="rapport_emails">Destinataires (e-mails)</label>
    <input type="text" form="form-reglages" id="rapport_emails" name="rapport_emails"
      value="<%= parametre.rapport_emails || '' %>"
      placeholder="admin@entreprise.local, responsable@…">
    <p style="font-size:12px;color:var(--gris);">Séparez les adresses par virgule. SMTP doit être configuré.</p>
  </div>
</div>
</div>

<style>
.reglages-grille {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
  gap: 18px;
  align-items: start;
}
@media (max-width: 900px) {
  .reglages-grille { grid-template-columns: 1fr; }
}
.reglages-col-droite { display: flex; flex-direction: column; gap: 16px; }
.reglages-col-droite .carte { max-width: none; }
</style>


<script>
(function () {
  var btn = document.getElementById('btn-parcourir-dossier');
  var inp = document.getElementById('input-parcourir-dossier');
  var champ = document.getElementById('sauvegarde_dossier');
  if (!btn || !inp || !champ) return;
  btn.addEventListener('click', function () { inp.click(); });
  inp.addEventListener('change', function () {
    if (!inp.files || !inp.files.length) return;
    var f = inp.files[0];
    // Chromium expose parfois path (file://) ou webkitRelativePath
    var pathHint = f.path || '';
    if (!pathHint && f.webkitRelativePath) {
      // webkitRelativePath = "MonDossier/fichier" → on ne connaît pas la racine absolue
      var folder = f.webkitRelativePath.split('/')[0];
      alert('Le navigateur ne fournit pas le chemin absolu du serveur.\n' +
        'Dossier sélectionné (nom) : ' + folder + '\n' +
        'Saisissez manuellement le chemin complet accessible par le Server GLO.');
      return;
    }
    if (pathHint) {
      // Retirer le nom de fichier pour garder le dossier
      pathHint = pathHint.replace(/[\\\/][^\\\/]+$/, '');
      champ.value = pathHint;
    }
  });
})();
</script>

<%- include('partials/footer') %>
