<%- include('../partials/header') %>

<div class="fil-ariane"><a href="/">Tableau de bord</a> <span class="sep">›</span> <%= titre %></div>
<div class="entete-page"><h1><%= titre %></h1></div>

<div class="carte" style="max-width:520px;">
    <% if (erreur) { %>
        <div class="message-erreur"><%= erreur %></div>
    <% } %>
    <p style="color:var(--gris); font-size:13px; margin-top:-4px;">
        En cas d'erreur de saisie, il faudra supprimer puis recréer l'utilisateur (pas de modification possible).
    </p>

    <form action="/utilisateurs" method="POST">
        <label for="matricule">Matricule</label>
        <input type="text" id="matricule" name="matricule" placeholder="0000.prenom" required>

        <label for="nom">Nom</label>
        <input type="text" id="nom" name="nom" required>

        <label for="prenom">Prénom</label>
        <input type="text" id="prenom" name="prenom" required>

        <label for="id_role">Rôle</label>
        <select id="id_role" name="id_role" required>
            <option value="">— Choisir un rôle —</option>
            <% roles.forEach(function(r) { %>
                <option value="<%= r.id %>"><%= r.nom %></option>
            <% }) %>
        </select>

        <label for="id_activite">Activité principale</label>
        <select id="id_activite" name="id_activite">
            <option value="">— Aucune —</option>
            <% activites.forEach(function(a) { %>
                <option value="<%= a.id %>" <%= String(a.id) === String(id_activite) ? 'selected' : '' %>><%= a.nom %></option>
            <% }) %>
        </select>

        <div class="actions-form">
            <button type="submit" class="btn btn-primaire">Créer</button>
            <a href="<%= id_activite ? '/activites/' + id_activite + '?onglet=utilisateurs' : '/' %>" class="btn btn-gris">Annuler</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
