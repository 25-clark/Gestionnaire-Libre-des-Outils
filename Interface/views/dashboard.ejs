<%- include('partials/header') %>
<%
  var idsActFav = (typeof idsActivitesFavoris !== 'undefined' ? idsActivitesFavoris : (typeof favorisActivitesIds !== 'undefined' ? favorisActivitesIds : [])) || [];
  var idsOutilFav = (typeof idsOutilsFavoris !== 'undefined' ? idsOutilsFavoris : (typeof favorisOutilsIds !== 'undefined' ? favorisOutilsIds : [])) || [];
  function estActFav(id) { return idsActFav.map(Number).indexOf(Number(id)) >= 0; }
  function estOutilFav(id) { return idsOutilFav.map(Number).indexOf(Number(id)) >= 0; }
%>

<div class="entete-page">
    <h1>Tableau de bord</h1>
    <% if (peut('activites', 'create')) { %>
        <a href="/activites/nouveau" class="btn btn-accent">+ Nouvelle activité</a>
    <% } %>
</div>

<% if ((typeof arboEpingles !== 'undefined' && arboEpingles.length) || (typeof outilsOrphelins !== 'undefined' && outilsOrphelins.length)) { %>
<div class="carte carte-epingles" style="margin-bottom:18px;">
    <h2 style="margin:0 0 12px;font-size:15px;">
        <i class="bi bi-bookmark-star-fill" style="color:#d97706;"></i> Épinglés
    </h2>
    <ul class="arbre-epingles">
        <% (arboEpingles || []).forEach(function(noeud) { %>
        <li class="noeud-epingle-activite">
            <div class="entete-epingle">
                <button type="button" class="btn-collapse-activite btn-favori est-epingle"
                        data-favori-type="activite" data-favori-id="<%= noeud.id %>"
                        title="Retirer des épinglés">
                    <i class="bi bi-pin-angle-fill"></i>
                </button>
                <a href="/activites/<%= noeud.id %>" class="lien-epingle">
                    <span class="icone-epingle-activite"><i class="bi bi-bookmark-star-fill"></i></span>
                    <strong><%= noeud.nom %></strong>
                    <% if (noeud.abbreviation) { %><span class="abbreviation"><%= noeud.abbreviation %></span><% } %>
                </a>
            </div>
            <% if (noeud.sousActivites && noeud.sousActivites.length) { %>
            <ul class="sous-arbre">
                <% noeud.sousActivites.forEach(function(sa) { %>
                <li>
                    <a class="noeud-sous-activite" href="/sous-activites/<%= sa.id %>">
                        <span class="icone-dossier-petit"><i class="bi bi-folder2-open"></i></span>
                        <span><%= sa.nom %></span>
                    </a>
                </li>
                <% }) %>
            </ul>
            <% } %>
            <% if (noeud.outils && noeud.outils.length) { %>
            <ul class="sous-arbre sous-arbre-outils">
                <% noeud.outils.forEach(function(o) { %>
                <li class="noeud-epingle-outil">
                    <button type="button" class="btn-favori-mini est-epingle" data-favori-type="outil" data-favori-id="<%= o.id %>" title="Retirer des épinglés">
                        <i class="bi bi-pin-angle-fill"></i>
                    </button>
                    <% if (o.lien) { %>
                    <a href="<%= o.lien %>" target="_blank" rel="noopener">
                        <i class="bi bi-bookmark-star"></i> <%= o.nom %>
                    </a>
                    <% } else { %>
                    <span><i class="bi bi-bookmark-star"></i> <%= o.nom %></span>
                    <% } %>
                </li>
                <% }) %>
            </ul>
            <% } %>
        </li>
        <% }) %>

        <% (outilsOrphelins || []).forEach(function(o) { %>
        <li class="noeud-epingle-outil orphelin">
            <button type="button" class="btn-favori-mini est-epingle" data-favori-type="outil" data-favori-id="<%= o.id %>" title="Retirer des épinglés">
                <i class="bi bi-pin-angle-fill"></i>
            </button>
            <% if (o.lien) { %>
            <a href="<%= o.lien %>" target="_blank" rel="noopener">
                <i class="bi bi-bookmark-star"></i> <%= o.nom %>
            </a>
            <% } else { %>
            <span><i class="bi bi-bookmark-star"></i> <%= o.nom %></span>
            <% } %>
        </li>
        <% }) %>
    </ul>
</div>
<% } %>

<% if (!arborescence.length) { %>
    <div class="carte vide">Aucune activité n'a encore été créée. Commencez par en ajouter une pour organiser vos outils.</div>
<% } %>

<ul class="arbre-activites">
    <% arborescence.forEach(function(activite) {
        var sous = activite.sousActivites || [];
        var aDesSous = sous.length > 0;
        var plusieursSous = sous.length > 1;
        var epingle = estActFav(activite.id);
    %>
    <li class="carte-activite<%= aDesSous ? ' a-sous-activites' : '' %>" data-activite-id="<%= activite.id %>">
        <div class="entete-activite">
            <% if (aDesSous) { %>
                <button type="button"
                        class="btn-collapse-activite"
                        data-cible="sous-<%= activite.id %>"
                        aria-expanded="<%= plusieursSous ? 'false' : 'true' %>"
                        title="<%= plusieursSous ? 'Déplier les sous-activités' : 'Replier les sous-activités' %>">
                    <i class="bi <%= plusieursSous ? 'bi-chevron-right' : 'bi-chevron-down' %>"></i>
                </button>
            <% } else { %>
                <span class="btn-collapse-placeholder"></span>
            <% } %>
            <button type="button"
                    class="btn-collapse-activite btn-favori<%= epingle ? ' est-epingle' : '' %>"
                    data-favori-type="activite"
                    data-favori-id="<%= activite.id %>"
                    title="<%= epingle ? 'Retirer des épinglés' : 'Épingler l\'activité' %>">
                <i class="bi <%= epingle ? 'bi-pin-angle-fill' : 'bi-pin-angle' %>"></i>
            </button>
            <a href="/activites/<%= activite.id %>" class="lien-entete-activite">
                <span class="icone-dossier">
                    <% if (epingle) { %><i class="bi bi-bookmark-star-fill" style="color:#d97706;"></i>
                    <% } else { %><i class="bi bi-folder2"></i><% } %>
                </span>
                <h2><%= activite.nom %></h2>
                <span class="abbreviation"><%= activite.abbreviation %></span>
                <% if (aDesSous) { %>
                    <span class="badge-nb-sous" title="Sous-activités"><%= sous.length %></span>
                <% } %>
            </a>
        </div>
        <% if (peut('sous_activites', 'read') && aDesSous) { %>
            <div class="bloc-sous-activites<%= plusieursSous ? ' est-replie' : '' %>" id="sous-<%= activite.id %>">
                <%- include('partials/arbre-sous-activites', { noeuds: sous, id_activite: activite.id }) %>
            </div>
        <% } %>
    </li>
    <% }) %>
</ul>

<script>
(function () {
    var STORAGE_KEY = 'glo_dashboard_collapse';
    function lireEtat() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
        catch (e) { return {}; }
    }
    function sauverEtat(etat) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(etat)); } catch (e) {}
    }
    function appliquer(btn, ouvert) {
        var cibleId = btn.getAttribute('data-cible');
        var bloc = document.getElementById(cibleId);
        var icon = btn.querySelector('i');
        if (!bloc) return;
        btn.setAttribute('aria-expanded', ouvert ? 'true' : 'false');
        btn.title = ouvert ? 'Replier les sous-activités' : 'Déplier les sous-activités';
        bloc.classList.toggle('est-replie', !ouvert);
        if (icon) {
            icon.classList.toggle('bi-chevron-down', ouvert);
            icon.classList.toggle('bi-chevron-right', !ouvert);
        }
    }
    var etat = lireEtat();
    document.querySelectorAll('.btn-collapse-activite[data-cible]').forEach(function (btn) {
        var li = btn.closest('.carte-activite');
        var id = li && li.getAttribute('data-activite-id');
        if (id && Object.prototype.hasOwnProperty.call(etat, id)) {
            appliquer(btn, !!etat[id]);
        }
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var ouvert = btn.getAttribute('aria-expanded') === 'true';
            appliquer(btn, !ouvert);
            if (id) {
                etat[id] = !ouvert;
                sauverEtat(etat);
            }
        });
    });
})();
</script>

<%- include('partials/footer') %>
