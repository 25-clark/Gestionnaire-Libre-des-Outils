<%- include('../partials/header') %>
<% var L = (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'fr'; %>
<div class="entete-page">
  <h1><i class="bi bi-life-preserver"></i> <%= titre %></h1>
</div>
<%- include('_nav') %>

<div class="carte" style="max-width:820px;">
<% if (L === 'en') { %>
  <h2 style="font-size:1.1rem;margin:0 0 8px;">How can we help you?</h2>
  <p>Use this form to contact the support team configured for your organisation. Your message is sent by e-mail to the address defined by the administrators (environment variable <code>SUPPORT_EMAIL</code>).</p>
  <ul style="color:var(--gris-fonce);">
    <li>Describe the issue clearly (what you were doing, what you expected, what happened).</li>
    <li>Mention the activity or tool involved, if any.</li>
    <li>For access rights or LDAP issues, also inform your local GLO administrator.</li>
  </ul>
<% } else { %>
  <h2 style="font-size:1.1rem;margin:0 0 8px;">Comment pouvons-nous vous aider&nbsp;?</h2>
  <p>Utilisez ce formulaire pour contacter l’équipe de support configurée pour votre organisation. Votre message est transmis par e-mail à l’adresse définie par les administrateurs (variable d’environnement <code>SUPPORT_EMAIL</code>).</p>
  <ul style="color:var(--gris-fonce);">
    <li>Décrivez clairement le problème (ce que vous faisiez, le résultat attendu, ce qui s’est produit).</li>
    <li>Indiquez l’activité ou l’outil concerné, le cas échéant.</li>
    <li>Pour les droits d’accès ou LDAP, informez également votre administrateur GLO interne.</li>
  </ul>
<% } %>

<% if (typeof succes !== 'undefined' && succes) { %><div class="message-succes"><%= succes %></div><% } %>
<% if (typeof erreur !== 'undefined' && erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>

<form action="/aide/support" method="POST" style="margin-top:16px;">
  <label for="categorie"><%= L === 'en' ? 'Category' : 'Catégorie' %></label>
  <select id="categorie" name="categorie" required>
    <% var cat = (form && form.categorie) || 'general'; %>
    <option value="general" <%= cat === 'general' ? 'selected' : '' %>><%= L === 'en' ? 'General question' : 'Question générale' %></option>
    <option value="bug" <%= cat === 'bug' ? 'selected' : '' %>><%= L === 'en' ? 'Bug / unexpected behaviour' : 'Anomalie / comportement inattendu' %></option>
    <option value="acces" <%= cat === 'acces' ? 'selected' : '' %>><%= L === 'en' ? 'Access & permissions' : 'Accès & permissions' %></option>
    <option value="outil" <%= cat === 'outil' ? 'selected' : '' %>><%= L === 'en' ? 'Tools' : 'Outils' %></option>
    <option value="ticket" <%= cat === 'ticket' ? 'selected' : '' %>><%= L === 'en' ? 'Tickets / assistance' : 'Tickets / assistance' %></option>
    <option value="compte" <%= cat === 'compte' ? 'selected' : '' %>><%= L === 'en' ? 'My account & security' : 'Mon compte & sécurité' %></option>
  </select>

  <label for="sujet"><%= L === 'en' ? 'Subject' : 'Sujet' %></label>
  <input type="text" id="sujet" name="sujet" required maxlength="120"
    value="<%= (form && form.sujet) ? form.sujet : '' %>"
    placeholder="<%= L === 'en' ? 'Short summary of your request' : 'Résumé court de votre demande' %>">

  <label for="contact"><%= L === 'en' ? 'Reply e-mail (optional)' : 'E-mail de réponse (optionnel)' %></label>
  <input type="email" id="contact" name="contact"
    value="<%= (form && form.contact) ? form.contact : (currentUser && currentUser.email ? currentUser.email : '') %>"
    placeholder="vous@exemple.com">

  <label for="message"><%= L === 'en' ? 'Message' : 'Message' %></label>
  <textarea id="message" name="message" rows="7" required minlength="10"
    placeholder="<%= L === 'en' ? 'Describe your request in detail…' : 'Décrivez votre demande en détail…' %>"><%= (form && form.message) ? form.message : '' %></textarea>

  <p style="font-size:12px;color:var(--gris);">
    <% if (L === 'en') { %>
      Your identity (name, employee ID) is attached automatically. SMTP must be configured on the server for delivery.
    <% } else { %>
      Votre identité (nom, matricule) est jointe automatiquement. Le serveur doit avoir SMTP configuré pour l’envoi.
    <% } %>
  </p>

  <div class="actions-form" style="margin-top:12px;">
    <button type="submit" class="btn btn-primaire">
      <i class="bi bi-send"></i> <%= L === 'en' ? 'Send request' : 'Envoyer la demande' %>
    </button>
    <a href="/tickets/nouveau" class="btn btn-gris"><%= L === 'en' ? 'Open a ticket instead' : 'Ouvrir un ticket à la place' %></a>
  </div>
</form>
</div>
<%- include('../partials/footer') %>
