<%- include('../partials/header') %>
<div class="entete-page">
  <h1><i class="bi bi-shield-lock"></i> Activité protégée</h1>
</div>
<div class="carte" style="max-width:420px;">
  <% if (erreur) { %><div class="message-erreur"><%= erreur %></div><% } %>
  <p style="color:var(--gris); font-size:14px;">
    L’activité <strong><%= activite.nom %></strong> est sécurisée. Saisissez la clé d’accès pour continuer.
  </p>
  <% if (activite.acces_indice) { %>
  <p style="font-size:13px; background:var(--gris-clair); padding:8px 12px; border-radius:8px;">
    <i class="bi bi-lightbulb"></i> Indice : <%= activite.acces_indice %>
  </p>
  <% } %>
  <form action="/activites/<%= activite.id %>/deverrouiller" method="POST">
    <input type="hidden" name="retour" value="<%= typeof retour !== 'undefined' ? retour : '/activites/' + activite.id %>">
    <label for="cle">Clé d’accès</label>
    <input type="password" id="cle" name="cle" required autofocus autocomplete="current-password" placeholder="Clé d’accès">
    <div class="actions-form">
      <button type="submit" class="btn btn-primaire">Déverrouiller</button>
      <a href="/" class="btn btn-gris">Retour au tableau de bord</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
