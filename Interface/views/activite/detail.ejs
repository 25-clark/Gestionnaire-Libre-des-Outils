<%- include('../partials/header') %>

<div class="fil-ariane"><a href="/">Tableau de bord</a> <span class="sep">›</span> <%= activite.nom %></div>

<div class="entete-page">
    <h1>
        <% if (activite.logo) { %><img src="<%= activite.logo %>" class="miniature" style="vertical-align:middle; margin-right:8px;"><% } %>
        <%= activite.nom %> <span style="color:var(--gris); font-weight:400; font-size:15px;">(<%= activite.abbreviation %>)</span>
    </h1>
    <% if (currentUser.Role && currentUser.Role.abbreviation === 'ADMIN') { %>
        <div style="display:flex; gap:8px;">
            <a href="/activites/<%= activite.id %>/modifier" class="btn btn-gris">Modifier</a>
            <form action="/activites/<%= activite.id %>/supprimer" method="POST" class="form-inline"
                  onsubmit="return confirm('Supprimer cette activité ?');">
                <button type="submit" class="btn btn-danger">Supprimer</button>
            </form>
        </div>
    <% } %>
</div>

<div class="onglets">
    <a class="onglet <%= onglet === 'sous-activites' ? 'actif' : '' %>" href="/activites/<%= activite.id %>?onglet=sous-activites">Sous-activités</a>
    <a class="onglet <%= onglet === 'utilisateurs' ? 'actif' : '' %>" href="/activites/<%= activite.id %>?onglet=utilisateurs">Utilisateurs</a>
    <a class="onglet <%= onglet === 'outils' ? 'actif' : '' %>" href="/activites/<%= activite.id %>?onglet=outils">Outils</a>
</div>

<% if (onglet === 'sous-activites') { %>
    <div class="entete-page">
        <span></span>
        <a href="/sous-activites/nouveau?id_activite=<%= activite.id %>" class="btn btn-accent"><i class="bi bi-plus-circle-dotted"></i> Nouvelle sous-activité</a>
    </div>

    <% if (!sousActivites.length) { %>
        <div class="carte vide">Aucune sous-activité pour l'instant.</div>
    <% } else { %>
        <div class="carte">
            <table class="tableau">
                <thead><tr><th>Nom</th><th>Sous-activité parente</th><th></th></tr></thead>
                <tbody>
                <% sousActivites.forEach(function(sa) { %>
                    <tr id="sa-<%= sa.id %>">
                        <td><%= sa.nom %></td>
                        <td><% if (sa.id_parent) {
                            const parent = sousActivites.find(function(p){ return p.id === sa.id_parent; });
                        %><%= parent ? parent.nom : '—' %><% } else { %>—<% } %></td>
                        <td style="text-align:right; white-space:nowrap;">
                            <a href="/sous-activites/<%= sa.id %>/modifier" class="btn btn-gris btn-petit">Modifier</a>
                            <a href="/outils/nouveau?id_activite=<%= activite.id %>&id_sous_activite=<%= sa.id %>" class="btn btn-gris btn-petit"><i class="bi bi-plus-circle-dotted"></i> Outil</a>
                            <form action="/sous-activites/<%= sa.id %>/supprimer" method="POST" class="form-inline"
                                  onsubmit="return confirm('Supprimer cette sous-activité ?');">
                                <button type="submit" class="btn btn-danger btn-petit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
<% } %>

<% if (onglet === 'utilisateurs') { %>
    <div class="entete-page">
        <span></span>
        <a href="/utilisateurs/nouveau?id_activite=<%= activite.id %>" class="btn btn-accent"><i class="bi bi-plus-circle-dotted"></i> Nouvel utilisateur</a>
    </div>

    <% if (!utilisateurs.length) { %>
        <div class="carte vide">Aucun utilisateur rattaché à cette activité.</div>
    <% } else { %>
        <div class="carte">
            <table class="tableau">
                <thead><tr><th>Matricule</th><th>Nom</th><th>Prénom</th><th>Rôle</th><th></th></tr></thead>
                <tbody>
                <% utilisateurs.forEach(function(u) { %>
                    <tr>
                        <td><%= u.matricule %></td>
                        <td><%= u.nom %></td>
                        <td><%= u.prenom %></td>
                        <td><span class="badge-role" style="background:var(--bleu);"><%= u.Role ? u.Role.abbreviation : '—' %></span></td>
                        <td style="text-align:right;">
                            <form action="/utilisateurs/<%= u.id %>/supprimer" method="POST" class="form-inline"
                                  onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                <button type="submit" class="btn btn-danger btn-petit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
<% } %>

<% if (onglet === 'outils') { %>
    <div class="entete-page">
        <span></span>
        <a href="/outils/nouveau?id_activite=<%= activite.id %>" class="btn btn-accent"><i class="bi bi-plus-circle-dotted"></i> Nouvel outil</a>
    </div>

    <% if (!outils.length) { %>
        <div class="carte vide">Aucun outil rattaché à cette activité.</div>
    <% } else { %>
        <div class="carte">
            <table class="tableau">
                <thead><tr><th></th><th>Nom</th><th>Lien</th><th>Propriétaire</th><th>Statut</th><th></th></tr></thead>
                <tbody>
                <% outils.forEach(function(o) { %>
                    <tr>
                        <td><% if (o.image) { %><img src="<%= o.image %>" class="miniature"><% } %></td>
                        <td><%= o.nom %></td>
                        <td><% if (o.lien) { %><a href="<%= o.lien %>" target="_blank" rel="noopener">Ouvrir ↗</a><% } else { %>—<% } %></td>
                        <td><%= o.Utilisateur ? o.Utilisateur.prenom + ' ' + o.Utilisateur.nom : '—' %></td>
                        <td>
                            <% if (o.active) { %>
                                <span class="pastille pastille-active">Actif</span>
                            <% } else { %>
                                <span class="pastille pastille-inactive">Désactivé</span>
                            <% } %>
                        </td>
                        <td style="text-align:right; white-space:nowrap;">
                            <form action="/outils/<%= o.id %>/toggle-active" method="POST" class="form-inline">
                                <input type="hidden" name="id_activite" value="<%= activite.id %>">
                                <button type="submit" class="btn btn-gris btn-petit"><%= o.active ? 'Désactiver' : 'Activer' %></button>
                            </form>
                            <form action="/outils/<%= o.id %>/supprimer" method="POST" class="form-inline"
                                  onsubmit="return confirm('Supprimer cet outil ?');">
                                <input type="hidden" name="id_activite" value="<%= activite.id %>">
                                <button type="submit" class="btn btn-danger btn-petit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
<% } %>

<%- include('../partials/footer') %>
