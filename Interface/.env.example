# =============================================================================
# GLO Interface — copier vers .env
# Local  : NODE_ENV=development  + API_URL local
# Prod   : NODE_ENV=production   + API_URL publique HTTPS
# =============================================================================

NODE_ENV=development

PORT=3000

# URL de l'API Server (avec le suffixe /api)
# Local :
API_URL=http://localhost:4000/api
# Prod exemple :
# API_URL=https://api.glo.example.com/api

# Secret session Interface (OBLIGATOIRE en production)
SESSION_SECRET=glo_interface_secret_a_changer

# Derrière reverse-proxy / Vercel (auto en production)
# TRUST_PROXY=1

# Cookies
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# COOKIE_CROSS_SITE=1
# SESSION_MAX_AGE_MS=28800000

GLO_UPDATE_URL=https://github.com/votre-org/glo/releases/latest
GLO_VERSION=1.0.0
GLO_SOUTIEN_TEL=
GLO_SOUTIEN_BANQUE=
GLO_SOUTIEN_TITULAIRE=
