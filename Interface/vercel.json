{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**",
          "routes/**",
          "middlewares/**",
          "utils/**",
          "config/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "public/css/$1" },
    { "src": "/js/(.*)", "dest": "public/js/$1" },
    { "src": "/uploads/(.*)", "dest": "public/uploads/$1" },
    { "src": "/(.*)", "dest": "app.js" }
  ]
}
