{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{views,public,routes,middlewares,utils,config}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
