{
  "version": 2,
  "installCommand": "cd Interface && npm install",
  "buildCommand": "cd Interface && npm run build",
  "functions": {
    "Interface/api/index.js": {
      "includeFiles": "Interface/{views,public,routes,middlewares,utils,config}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/Interface/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/Interface/public/js/$1" },
    { "source": "/(.*)", "destination": "/Interface/api" }
  ]
}
