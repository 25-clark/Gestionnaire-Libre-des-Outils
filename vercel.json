{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "glo-interface",
  "buildCommand": "cd Interface && npm install && npm run build",
  "installCommand": "cd Interface && npm install",
  "framework": null,
  "builds": [
    {
      "src": "Interface/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Interface/views/**",
          "Interface/public/**",
          "Interface/routes/**",
          "Interface/middlewares/**",
          "Interface/utils/**",
          "Interface/config/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "Interface/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "Interface/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Interface/app.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
