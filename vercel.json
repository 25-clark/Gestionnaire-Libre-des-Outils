{
  "version": 2,
  "buildCommand": "cd Interface && npm install && npm run build",
  "installCommand": "cd Interface && npm install",
  "builds": [
    {
      "src": "Interface/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Interface/views/**",
          "Interface/public/**",
          "Interface/routes/**",
          "Interface/middlewares/**",
          "Interface/utils/**",
          "Interface/config/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "Interface/public/css/$1" },
    { "src": "/js/(.*)", "dest": "Interface/public/js/$1" },
    { "src": "/(.*)", "dest": "Interface/app.js" }
  ]
}
