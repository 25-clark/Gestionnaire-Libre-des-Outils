{
  "version": 2,
  "installCommand": "npm install --prefix Interface",
  "buildCommand": "npm run build --prefix Interface",
  "functions": {
    "Interface/api/index.js": {
      "includeFiles": "Interface/{views,public,routes,middlewares,utils,config,node_modules}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/Interface/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/Interface/public/js/$1" },
    { "source": "/(.*)", "destination": "/Interface/api" }
  ]
}
