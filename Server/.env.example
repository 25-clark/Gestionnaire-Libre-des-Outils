# Copier ce fichier en ".env" et remplir les valeurs

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glo_db
DB_USER=root
DB_PASS=

# Serveur
PORT=4000

# Session (change cette valeur en prod)
SESSION_SECRET=change_moi_en_production

# URL autorisée à appeler l'API (Interface/)
CLIENT_URL=http://localhost:3000

# Clé de chiffrement des credentials d'outils (AES-256-GCM).
# Obligatoire en production — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si absent, SESSION_SECRET est utilisé en secours (moins isolé).
CREDENTIALS_SECRET=

# E-mail — code de connexion (exemple Gmail)
# 1) Activer la validation en 2 étapes sur le compte Google
# 2) Créer un « Mot de passe d'application » (Sécurité Google)
# 3) Coller ce mot de passe 16 caractères dans SMTP_PASS (sans espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=
SMTP_FROM=votre.adresse@gmail.com
