# =============================================================================
# GLO Server — copier vers .env
# Local  : NODE_ENV=development
# Prod   : NODE_ENV=production (+ secrets forts, CLIENT_URL, DB cloud)
# =============================================================================

NODE_ENV=development

# --- Base de données MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glo_db
DB_USER=root
DB_PASS=
# Prod cloud (PlanetScale, etc.) : DB_SSL=true
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10
# DB_LOGGING=0

# --- API ---
PORT=4000

# Secret session (OBLIGATOIRE en production — ne pas laisser la valeur d'exemple)
SESSION_SECRET=change_moi_en_production

# Chiffrement credentials (recommandé distinct de SESSION_SECRET)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_SECRET=

# Origine(s) de l'Interface autorisée(s) pour CORS (virgules si plusieurs)
# Local :
CLIENT_URL=http://localhost:3000
# Prod exemple :
# CLIENT_URL=https://glo.example.com
# CLIENT_URLS=https://glo.example.com,https://glo-interface.vercel.app

# Derrière Nginx / Vercel / reverse-proxy : TRUST_PROXY=1 (auto en production)
# TRUST_PROXY=1

# Cookies (auto : secure en production)
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# Si Interface et API sur des domaines différents en HTTPS :
# COOKIE_CROSS_SITE=1
# COOKIE_SAME_SITE=none
# SESSION_MAX_AGE_MS=28800000

# --- SMTP (codes e-mail / support) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SUPPORT_EMAIL=support@votre-entreprise.local
GLO_UPDATE_URL=https://github.com/votre-org/glo/releases/latest
GLO_VERSION=1.0.0
GLO_SOUTIEN_TEL=
GLO_SOUTIEN_BANQUE=
GLO_SOUTIEN_TITULAIRE=
