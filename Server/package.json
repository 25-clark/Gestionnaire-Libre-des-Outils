{
  "name": "glo-server",
  "version": "1.0.0",
  "description": "Backend - Gestionnaire d'outils par activit\u00e9 (GLO)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js",
    "seed": "node seed.js",
    "migrate": "node migrate.js",
    "reset-installation": "node reset-installation.js",
    "lint": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern uploads",
    "lint:fix": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern uploads --fix",
    "build": "node --check server.js && node --check migrate.js && node --check seed.js && echo \"[build] Server syntax OK\"",
    "start:local": "node server.js",
    "start:prod": "node server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "nodemailer": "^6.9.16"
  },
  "optionalDependencies": {
    "ldapjs": "^3.0.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}